{"kaza": 5.491383000000001, "poll": 20.017278, "cd0": 24.850870050000005, "rew": 28.873809, "rewDur": 0.8, "slow": 29.673809000000002, "karar": 38.809523000000006, "ders": 51.219115, "next": 54.3632781, "end": 58.945032999999995, "suc": 999, "cut": 999, "_imp": 16.369373425196848, "map": [[5.491383000000001, 1.7999999999999998], [12.530657, 4.0], [16.369373425196848, 6.0], [20.017278, 7.4]], "rwTo": 3.4, "slowRate": 0.26270524668351036, "clues": [[30.451134558139536, "Tanıklar dinleniyor"], [32.944822186046515, "Haftada 5,5 saat fazla mesai"], [36.21778719767442, "Ödendiği ispatlanamadı"]], "reasons": [[41.00054150236967, "Tanıkla ispat mümkün"], [43.37302146445498, "Ödeme ispatı işverende"]], "hukum": 45.86123215639811, "onay": 49.369115, "caps": [[0.25, 1.49, "Bordroyu imzaladıysan,"], [1.49, 2.91, "fazla mesai<br>isteyemezsin."], [2.91, 4.15, "Genelde böyle bilinir."], [4.15, 5.34, "Peki mahkeme ne dedi?"], [5.54, 8.57, "Bir şirket çalışanı 6,5<br>yıl boyunca çalışıyor."], [8.57, 10.17, "Her ay bordrosunu<br>imzalıyor."], [10.17, 12.45, "Haftada birkaç saat<br>de fazladan kalıyor."], [12.53, 15.33, "İşten çıkarılınca fazla<br>mesai ücretini istiyor."], [15.33, 16.34, "İşveren diyor ki:"], [16.34, 17.83, "Bordroların<br>hepsi imzalı."], [17.83, 19.92, "Tanıkla fazla mesai<br>ispat edilemez."], [20.12, 23.25, "Sizce çalışan fazla<br>mesai ücretini aldı mı?"], [23.25, 24.71, "A, hayır, imza onun."], [24.71, 26.17, "B, sadece bir ayını."], [26.17, 28.72, "C, evet, aldı.<br>Cevabını yoruma yaz."], [29.72, 32.93, "Geri saralım. Mahkeme iş<br>arkadaşlarını tanık olarak dinliyor."], [32.93, 36.19, "Tanıklar haftada 5,5 saat<br>fazla çalışıldığını anlatıyor."], [36.19, 38.66, "İşveren bu saatlerin<br>ödendiğini ispat edemiyor."], [38.86, 41.0, "Mahkeme imza itirazını<br>kabul etmedi:"], [41.0, 43.39, "Fazla mesai tanıkla<br>da ispat edilebilir."], [43.39, 45.89, "Ödendiğini ispat etmek<br>ise işverene düşer."], [45.89, 47.32, "Çalışan fazla mesaisini,"], [47.32, 48.92, "kıdem ve ihbar<br>tazminatını,"], [48.92, 50.18, "izin ücretini alacak."], [50.18, 51.07, "Yargıtay onadı."], [51.27, 54.28, "İmzalı bordro, fazla mesai<br>hakkını tek başına silmez."], [54.28, 56.84, "Mesai saatlerini bilen<br>tanıkların çok önemli."], [56.84, 58.15, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.541383000000001, 12.530657, 20.117278000000002, 29.723809000000003, 38.859523, 51.269115]}