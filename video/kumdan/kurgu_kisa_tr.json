{"sahneler": [{"ad": "hero", "bas": 0, "son": 5.9300630000000005}, {"ad": "kuvars", "bas": 5.9300630000000005, "son": 11.315626000000002}, {"ad": "firin", "bas": 11.315626000000002, "son": 15.345357100000001}, {"ad": "siemens", "bas": 15.345357100000001, "son": 20.270584}, {"ad": "kutuk", "bas": 20.270584, "son": 28.124667}, {"ad": "dilim", "bas": 28.124667, "son": 33.84923}, {"ad": "hucre", "bas": 33.84923, "son": 39.889105}, {"ad": "panel", "bas": 39.889105, "son": 45.262293}, {"ad": "nakliye", "bas": 45.262293, "son": 49.550835}, {"ad": "montaj", "bas": 49.550835, "son": 55.320898}, {"ad": "uretim", "bas": 55.320898, "son": 62.888252}, {"ad": "son", "bas": 62.888252, "son": 70.673481}], "altyazi": [{"bas": 0.4, "son": 3.04, "metin": "Bu güneş paneli... bir zamanlar bir avuç"}, {"bas": 3.04, "son": 5.68, "metin": "kumdu! Kumdan elektriğe, işte yolculuğu."}, {"bas": 5.93, "son": 7.347, "metin": "Her şey kuvarsla başlar."}, {"bas": 7.347, "son": 9.708, "metin": "Silisyum, yer kabuğunda oksijenden sonra"}, {"bas": 9.708, "son": 11.066, "metin": "en bol bulunan element."}, {"bas": 11.316, "son": 13.774, "metin": "Kuvars, iki bin dereceye yaklaşan ark"}, {"bas": 13.774, "son": 15.635, "metin": "fırınında karbonla eritilir."}, {"bas": 15.635, "son": 18.094, "metin": "Sonra öyle arıtılır ki, milyon atomda"}, {"bas": 18.094, "son": 20.021, "metin": "birden az yabancı atom kalır."}, {"bas": 20.271, "son": 22.32, "metin": "Bin dört yüz derecede eriyen silisyuma"}, {"bas": 22.32, "son": 24.207, "metin": "küçük bir tohum kristal daldırılır."}, {"bas": 24.207, "son": 25.879, "metin": "Döndürülerek yavaşça çekilir..."}, {"bas": 25.879, "son": 27.875, "metin": "ve tek parça kristal bir kütük büyür."}, {"bas": 28.125, "son": 31.049, "metin": "Kütük, elmas kaplı tellerle dilimlenir."}, {"bas": 31.049, "son": 33.599, "metin": "Her dilim yalnızca 0,15 milimetre!"}, {"bas": 33.849, "son": 36.058, "metin": "Dilimler pürüzlendirilir, katkılanır,"}, {"bas": 36.058, "son": 37.729, "metin": "kaplanır ve hücreye dönüşür."}, {"bas": 37.729, "son": 39.639, "metin": "Gümüş çizgiler elektriği toplar."}, {"bas": 39.889, "son": 41.855, "metin": "Hücreler birbirine bağlanır; cam,"}, {"bas": 41.855, "son": 43.702, "metin": "koruyucu katmanlar ve alüminyum"}, {"bas": 43.702, "son": 45.012, "metin": "çerçeveyle panel olur."}, {"bas": 45.262, "son": 47.166, "metin": "Paletlere dizilir, konteynerlerle"}, {"bas": 47.166, "son": 49.301, "metin": "okyanus aşar, tırlarla sahaya ulaşır."}, {"bas": 49.551, "son": 51.782, "metin": "Sahada kazıklar çakılır, konstrüksiyon"}, {"bas": 51.782, "son": 54.073, "metin": "kurulur, paneller tek tek monte edilir,"}, {"bas": 54.073, "son": 55.071, "metin": "kablolar çekilir."}, {"bas": 55.321, "son": 57.694, "metin": "Ve güneş doğar. Işık hücreye çarpar,"}, {"bas": 57.694, "son": 59.474, "metin": "elektronlar harekete geçer."}, {"bas": 59.474, "son": 61.122, "metin": "İnvertör akımı çevirir..."}, {"bas": 61.122, "son": 62.638, "metin": "elektrik şebekeye akar."}, {"bas": 62.888, "son": 64.928, "metin": "Yirmi beş yıldan uzun süre, yakıt"}, {"bas": 64.928, "son": 66.969, "metin": "yakmadan elektrik! Hepsi bir avuç"}, {"bas": 66.969, "son": 68.823, "metin": "kumdan. Kozmos Lab'i takip et."}], "gecis": "flas", "toplam": 70.673481}