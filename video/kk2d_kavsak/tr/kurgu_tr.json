{"toplam": 66.424, "dil": "tr", "parca": {"V1": [0.35, 4.207], "V2": [4.207, 13.522], "V3": [13.522, 21.161], "V4": [21.161, 30.765], "V5": [30.765, 40.001], "V6": [40.001, 53.846], "V7": [53.846, 66.424]}, "sayac": [28.165, 30.665], "altyazi": [{"bas": 0.35, "son": 1.776, "metin": "Kavşağa önce giren geçer."}, {"bas": 1.776, "son": 2.859, "metin": "Herkes böyle bilir."}, {"bas": 2.859, "son": 4.057, "metin": "Peki mahkeme ne dedi?"}, {"bas": 4.207, "son": 5.548, "metin": "Şehir içinde bir kavşak."}, {"bas": 5.548, "son": 7.616, "metin": "Hava açık, yol kuru, hız sınırı elli."}, {"bas": 7.616, "son": 9.516, "metin": "Bir kamyonet yan sokaktan geliyor."}, {"bas": 9.516, "son": 11.025, "metin": "Köşede bir DUR levhası var."}, {"bas": 11.025, "son": 13.372, "metin": "Sağ taraftan da bir motosiklet yaklaşıyor."}, {"bas": 13.522, "son": 15.436, "metin": "Kamyonet durmuyor, kavşağa giriyor."}, {"bas": 15.436, "son": 17.294, "metin": "Motosiklet de yavaşlamadan kavşağa"}, {"bas": 17.294, "son": 18.552, "metin": "giriyor. Çarpışıyorlar."}, {"bas": 18.552, "son": 20.465, "metin": "Motosikletlinin kemiği ağır şekilde"}, {"bas": 20.465, "son": 21.011, "metin": "kırılıyor."}, {"bas": 21.161, "son": 22.507, "metin": "Sence kim kusurlu?"}, {"bas": 22.507, "son": 23.928, "metin": "A, sadece kamyonet."}, {"bas": 23.928, "son": 25.498, "metin": "B, sadece motosiklet."}, {"bas": 25.498, "son": 27.965, "metin": "C, ikisi de. Cevabını yoruma yaz."}, {"bas": 30.765, "son": 32.335, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 32.335, "son": 34.355, "metin": "kamyonetin önünde DUR levhası vardı."}, {"bas": 34.355, "son": 36.71, "metin": "İkinci ipucu: motosiklet sağdan geliyordu."}, {"bas": 36.71, "son": 38.505, "metin": "Üçüncü ipucu: motosiklet kavşağa"}, {"bas": 38.505, "son": 39.851, "metin": "yaklaşırken yavaşlamadı."}, {"bas": 40.001, "son": 41.275, "metin": "Bilirkişi raporları net."}, {"bas": 41.275, "son": 43.452, "metin": "Kamyonet sürücüsü DUR levhasında durmadı,"}, {"bas": 43.452, "son": 44.619, "metin": "geçiş hakkını vermedi:"}, {"bas": 44.619, "son": 46.742, "metin": "asli kusurlu. Dört bin beş yüz lira adli"}, {"bas": 46.742, "son": 48.972, "metin": "para cezası, ehliyeti dört ay geri alındı."}, {"bas": 48.972, "son": 50.883, "metin": "Ama geçiş hakkı olan motosikletli de"}, {"bas": 50.883, "son": 52.581, "metin": "yavaşlamadığı için tali kusurlu."}, {"bas": 52.581, "son": 53.696, "metin": "Yargıtay hükmü onadı."}, {"bas": 53.846, "son": 56.034, "metin": "Yasada kavşağa önce giren geçer diye bir"}, {"bas": 56.034, "son": 58.003, "metin": "kural yok. Sırayı levha, ışık ve yol"}, {"bas": 58.003, "son": 60.082, "metin": "belirler. İşaret yoksa soldaki, sağdan"}, {"bas": 60.082, "son": 61.012, "metin": "gelene yol verir."}, {"bas": 61.012, "son": 63.31, "metin": "Geçiş hakkın olsa bile kavşakta yavaşlamak"}, {"bas": 63.31, "son": 65.224, "metin": "zorundasın. Sen hangi şıkkı seçtin?"}], "carp": 17.921999999999997, "tali": 48.993, "onayT": 52.611, "ip": [31.531, 34.378, 36.786]}