{"sahneler": [{"ad": "s0", "bas": 0, "son": 5.500063}, {"ad": "s1", "bas": 5.500063, "son": 9.880126}, {"ad": "s2", "bas": 9.880126, "son": 16.06748}, {"ad": "s3", "bas": 16.06748, "son": 22.946355}, {"ad": "s4", "bas": 22.946355, "son": 30.319793}], "altyazi": [{"bas": 0.4, "son": 2.863, "metin": "Kırk kiloluk bir kargoyu dağın tepesine"}, {"bas": 2.863, "son": 5.2, "metin": "kim taşır? Yol yoksa cevap: bu drone!"}, {"bas": 5.5, "son": 7.799, "metin": "Sekiz pervane, bir yük kutusu ve altında"}, {"bas": 7.799, "son": 9.58, "metin": "yirmi metrelik bir vinç halatı."}, {"bas": 9.88, "son": 11.771, "metin": "Drone inmeden havada asılı kalıyor."}, {"bas": 11.771, "son": 13.715, "metin": "Halat paketi yavaşça yere indiriyor."}, {"bas": 13.715, "son": 15.767, "metin": "İnecek yer olmasa bile teslimat tamam!"}, {"bas": 16.067, "son": 18.302, "metin": "Çift bataryayla otuz kiloluk yükü on"}, {"bas": 18.302, "son": 20.102, "metin": "altı kilometre taşıyabiliyor."}, {"bas": 20.102, "son": 22.212, "metin": "Bir sorun çıkarsa kendi paraşütünü"}, {"bas": 22.212, "son": 22.646, "metin": "açıyor."}, {"bas": 22.946, "son": 25.014, "metin": "Tarla, güneş santrali, dağ başı..."}, {"bas": 25.014, "son": 26.717, "metin": "Sence drone'lar başka nerede"}, {"bas": 26.717, "son": 28.42, "metin": "kullanılmalı? Yorumlara yaz."}], "gecis": "flas", "toplam": 30.32, "dil": "tr"}