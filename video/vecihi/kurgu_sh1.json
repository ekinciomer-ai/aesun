{"sahneler": [{"ad": "sh1_1", "bas": 0, "son": 4.117604}, {"ad": "sh1_2", "bas": 4.117604, "son": 11.997979}, {"ad": "sh1_3", "bas": 11.997979, "son": 22.201542000000003}, {"ad": "sh1_4", "bas": 22.201542000000003, "son": 31.582625000000004}, {"ad": "sh1_5", "bas": 31.582625000000004, "son": 40.398146000000004}], "altyazi": [{"bas": 0.2, "son": 2.47, "metin": "Bu adam, Türkiye'nin ilk uçağını yaptı."}, {"bas": 2.47, "son": 3.868, "metin": "Ve bunun için ceza aldı."}, {"bas": 4.118, "son": 6.614, "metin": "Yıl 1925, İzmir."}, {"bas": 6.614, "son": 9.395, "metin": "Vecihi Hürkuş savaştan kalan parçalarla"}, {"bas": 9.395, "son": 11.748, "metin": "bir uçak yapıyor: Vecihi K-VI."}, {"bas": 11.998, "son": 14.52, "metin": "Onay heyetinde uçağı denetleyebilecek"}, {"bas": 14.52, "son": 17.111, "metin": "kimse yok. Heyetten biri diyor ki: Biz"}, {"bas": 17.111, "son": 18.884, "metin": "sana bu lisansı veremeyiz."}, {"bas": 18.884, "son": 21.474, "metin": "Uçağına güveniyorsan atla, uç, bizi de"}, {"bas": 21.474, "son": 21.952, "metin": "kurtar."}, {"bas": 22.202, "son": 23.885, "metin": "28 Ocak, saat 15.00."}, {"bas": 23.885, "son": 25.245, "metin": "15 dakika uçuyor."}, {"bas": 25.245, "son": 27.836, "metin": "Türkiye'de yapılan bir uçağın ilk uçuşu."}, {"bas": 27.836, "son": 29.584, "metin": "Sonuç: izinsiz uçuş cezası."}, {"bas": 29.584, "son": 31.333, "metin": "Uçağını bir daha göremiyor."}, {"bas": 31.583, "son": 33.396, "metin": "Ama 2026'da Hava"}, {"bas": 33.396, "son": 35.834, "metin": "Kuvvetleri'nin yeni eğitim uçağının adı"}, {"bas": 35.834, "son": 37.46, "metin": "ne, biliyor musun? Hürkuş."}, {"bas": 37.46, "son": 38.648, "metin": "Tam hikâye kanalda."}], "gecis": "kara", "toplam": 40.398, "dil": "tr"}