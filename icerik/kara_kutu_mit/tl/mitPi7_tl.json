{"kaza": 5.84161, "poll": 20.815646, "cd0": 25.961602850000002, "rew": 30.240113, "rewDur": 0.8, "slow": 31.040113, "karar": 40.015601, "ders": 52.57945599999999, "next": 55.05590504999999, "end": 58.821564999999985, "suc": 999, "cut": 999, "_imp": 17.829280525925927, "map": [[5.84161, 1.7999999999999998], [13.363583, 4.0], [17.829280525925927, 6.0], [20.815646, 7.4]], "rwTo": 3.4, "slowRate": 0.26739493161820294, "clues": [[31.857968200000002, "Hesap bilirkişide"], [33.2291382, "Ödenmemiş mesai var"], [35.2584698, "Saatini kendi belirlemiyor"]], "reasons": [[41.11130017910447, "Ücret ödenmezse haklı fesih"], [45.35560861194029, "İstifa değil, haklı fesih"]], "hukum": 47.385495253731335, "onay": 50.72945599999999, "caps": [[0.25, 1.65, "İşten kendin ayrılırsan,"], [1.65, 3.18, "kıdem tazminatı<br>alamazsın."], [3.18, 4.46, "Genelde böyle bilinir."], [4.46, 5.69, "Peki mahkeme ne dedi?"], [5.89, 8.93, "Bir bankada müdür yardımcısı<br>on 2 yıldır çalışıyor."], [8.93, 11.05, "Akşamları geç saatlere<br>kadar kalıyor."], [11.05, 13.28, "Fazla mesailerinin<br>karşılığı ödenmiyor."], [13.36, 16.87, "Sonunda dilekçesini verip ayrılıyor<br>ve kıdem tazminatı istiyor."], [16.87, 17.82, "İşveren diyor ki:"], [17.82, 18.93, "Kendisi istifa etti,"], [18.93, 20.72, "üstelik başka bir<br>bankaya geçti."], [20.92, 24.28, "Sizce müdür yardımcısı<br>kıdem tazminatı aldı mı?"], [24.28, 25.5, "A, evet, aldı. B,"], [25.5, 26.86, "hayır, istifa etti."], [26.86, 28.66, "C, sadece<br>mesai ücretini."], [28.66, 30.09, "Cevabını yoruma yaz."], [31.09, 33.21, "Geri saralım. Bilirkişi<br>hesap yapıyor."], [33.21, 35.23, "Ödenmemiş fazla<br>mesai gerçekten var."], [35.23, 36.18, "Tanıklar da onun,"], [36.18, 39.87, "kendi çalışma saatini belirleyen<br>bir yönetici olmadığını söylüyor."], [40.07, 41.07, "Mahkeme dedi ki:"], [41.07, 43.35, "Ücretin tam ve<br>zamanında ödenmemesi,"], [43.35, 45.3, "işçiye haklı<br>fesih hakkı verir."], [45.3, 46.31, "Bu istifa değil,"], [46.31, 51.48, "haklı fesihtir. Müdür yardımcısı kıdem<br>tazminatını ve fazla mesai ücretini alacak."], [51.48, 52.43, "Yargıtay onadı."], [52.63, 55.35, "Ücretin ya da mesain<br>ödenmediği için ayrılırsan,"], [55.35, 56.72, "kıdem tazminatın yanmaz."], [56.72, 58.02, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.89161, 13.363583, 20.915646000000002, 31.090113000000002, 40.065600999999994, 52.62945599999999]}