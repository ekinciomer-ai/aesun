{"sahneler": [{"ad": "havada", "bas": 0, "son": 6.166271}, {"ad": "pervane", "bas": 6.166271, "son": 14.193084}, {"ad": "egil", "bas": 14.193084, "son": 18.40167165}, {"ad": "don", "bas": 18.40167165, "son": 23.545501}, {"ad": "beyin", "bas": 23.545501, "son": 31.699501}, {"ad": "son", "bas": 31.699501, "son": 41.734500999999995}], "altyazi": [{"bas": 0.4, "son": 2.435, "metin": "Bu küçük makine havada nasıl çakılı"}, {"bas": 2.435, "son": 4.529, "metin": "kalıyor? Cevap, gözünün göremeyeceği"}, {"bas": 4.529, "son": 5.866, "metin": "kadar hızlı bir hilede!"}, {"bas": 6.166, "son": 8.435, "metin": "Dört pervane var. İkisi saat yönünde,"}, {"bas": 8.435, "son": 9.846, "metin": "ikisi ters yönde döner."}, {"bas": 9.846, "son": 12.176, "metin": "Neden mi? Yoksa drone topaç gibi kendi"}, {"bas": 12.176, "son": 13.893, "metin": "etrafında fırıl fırıl döner!"}, {"bas": 14.193, "son": 15.723, "metin": "İleri gitmek mi istiyor?"}, {"bas": 15.723, "son": 18.273, "metin": "Arkadaki motorlar hızlanır, burun eğilir"}, {"bas": 18.273, "son": 20.696, "metin": "ve süzülür. Kendi etrafında dönmek mi?"}, {"bas": 20.696, "son": 22.672, "metin": "Çiftlerden biri hızlanır, öteki"}, {"bas": 22.672, "son": 23.246, "metin": "yavaşlar."}, {"bas": 23.546, "son": 26.016, "metin": "Ama asıl kahraman içerideki beyin: uçuş"}, {"bas": 26.016, "son": 28.549, "metin": "bilgisayarı. Saniyede yüzlerce kez eğimi"}, {"bas": 28.549, "son": 30.766, "metin": "ve yüksekliği ölçüp her motoru ayrı"}, {"bas": 30.766, "son": 31.4, "metin": "ayarlıyor."}, {"bas": 31.7, "son": 33.43, "metin": "Yani sen kumandada sadece yön"}, {"bas": 33.43, "son": 35.279, "metin": "veriyorsun, gerisini o yapıyor."}, {"bas": 35.279, "son": 37.487, "metin": "Peki drone uçurmak için artık ehliyet"}, {"bas": 37.487, "son": 39.635, "metin": "şart mı? Cevap yarın, Kozmos Lab'da!"}], "gecis": "flas", "toplam": 41.735, "dil": "tr"}