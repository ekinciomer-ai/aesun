{"sahneler": [{"ad": "hero", "bas": 0, "son": 19.178021}, {"ad": "ruzgar", "bas": 19.178021, "son": 40.535875}, {"ad": "kanat", "bas": 40.535875, "son": 65.60333299999999}, {"ad": "nasel", "bas": 65.60333299999999, "son": 91.80339599999999}, {"ad": "nakliye", "bas": 91.80339599999999, "son": 105.36027099999998}, {"ad": "kurulum", "bas": 105.36027099999998, "son": 122.92033399999998}, {"ad": "uretim", "bas": 122.92033399999998, "son": 139.60710499999996}, {"ad": "koruma", "bas": 139.60710499999996, "son": 160.23375099999996}, {"ad": "son", "bas": 160.23375099999996, "son": 173.99697999999995}], "altyazi": [{"bas": 0.6, "son": 3.046, "metin": "Rüzgâr türbinleri uzaktan sakin görünür."}, {"bas": 3.046, "son": 5.37, "metin": "Ama her birinin içinde yüzlerce tonluk"}, {"bas": 5.37, "son": 6.532, "metin": "bir makine çalışır."}, {"bas": 6.532, "son": 8.794, "metin": "Bu videoda bir rüzgâr türbinini parça"}, {"bas": 8.794, "son": 11.24, "metin": "parça açıyoruz. Örneğimiz, mühendislerin"}, {"bas": 11.24, "son": 13.075, "metin": "hesaplarda kullandığı NREL beş"}, {"bas": 13.075, "son": 15.459, "metin": "megavatlık referans türbini: rotor çapı"}, {"bas": 15.459, "son": 17.783, "metin": "yüz yirmi altı metre, göbek yüksekliği"}, {"bas": 17.783, "son": 18.578, "metin": "doksan metre."}, {"bas": 19.178, "son": 20.558, "metin": "Önce rüzgârın kendisi."}, {"bas": 20.558, "son": 22.314, "metin": "Güneş Dünya'yı eşit ısıtmaz."}, {"bas": 22.314, "son": 24.759, "metin": "Isınan hava hafifleyip yükselir, yerine"}, {"bas": 24.759, "son": 26.076, "metin": "daha serin hava akar."}, {"bas": 26.076, "son": 27.582, "metin": "Bu akışa rüzgâr diyoruz."}, {"bas": 27.582, "son": 29.839, "metin": "Rüzgârdaki güç, hızın küpüyle artar:"}, {"bas": 29.839, "son": 32.285, "metin": "rüzgâr iki kat hızlanırsa, taşıdığı güç"}, {"bas": 32.285, "son": 34.668, "metin": "sekiz kat artar. Bu türbin saniyede üç"}, {"bas": 34.668, "son": 36.988, "metin": "metrede dönmeye başlar, on bir virgül"}, {"bas": 36.988, "son": 39.497, "metin": "dört metrede tam güce, yani beş megavata"}, {"bas": 39.497, "son": 39.936, "metin": "ulaşır."}, {"bas": 40.536, "son": 43.034, "metin": "Kanatlar, uçak kanadı gibi profillidir."}, {"bas": 43.034, "son": 45.596, "metin": "Kökte yuvarlak başlar, uca doğru incelir"}, {"bas": 45.596, "son": 47.966, "metin": "ve burulur. Her biri altmış bir buçuk"}, {"bas": 47.966, "son": 50.272, "metin": "metre ve yaklaşık on yedi buçuk ton."}, {"bas": 50.272, "son": 52.449, "metin": "Dev kalıplara cam elyaf katmanları"}, {"bas": 52.449, "son": 54.947, "metin": "serilir, ortadaki ana yükü karbon kiriş"}, {"bas": 54.947, "son": 57.125, "metin": "başlıkları taşır, iki kabuğu kesme"}, {"bas": 57.125, "son": 59.367, "metin": "gövdeleri bağlar. Aradaki boşluklar"}, {"bas": 59.367, "son": 61.929, "metin": "balsa ya da köpük çekirdekle doldurulur,"}, {"bas": 61.929, "son": 64.363, "metin": "sonra hepsi reçineyle tek parça hâline"}, {"bas": 64.363, "son": 65.003, "metin": "getirilir."}, {"bas": 65.603, "son": 68.083, "metin": "Kulenin tepesindeki gövdeye nasel denir;"}, {"bas": 68.083, "son": 70.438, "metin": "bu türbinde yaklaşık iki yüz kırk ton."}, {"bas": 70.438, "son": 72.608, "metin": "Rotor, dakikada en fazla on iki tur"}, {"bas": 72.608, "son": 74.591, "metin": "döner. Bu yavaş dönüş ana milden"}, {"bas": 74.591, "son": 76.947, "metin": "şanzımana geçer. Şanzıman devri doksan"}, {"bas": 76.947, "son": 79.426, "metin": "yedi kat artırır; jeneratör dakikada bin"}, {"bas": 79.426, "son": 81.1, "metin": "yüz yetmiş dört tura çıkar."}, {"bas": 81.1, "son": 83.207, "metin": "Hızlı milde fren diski, arkada güç"}, {"bas": 83.207, "son": 85.377, "metin": "çevirici, trafo ve soğutucu, tepede"}, {"bas": 85.377, "son": 86.864, "metin": "rüzgâr ölçerler bulunur."}, {"bas": 86.864, "son": 89.158, "metin": "Bazı türbinlerde şanzıman hiç yoktur;"}, {"bas": 89.158, "son": 91.203, "metin": "jeneratör doğrudan rotorla döner."}, {"bas": 91.803, "son": 93.881, "metin": "Bu boyutta kanatları taşımak başlı"}, {"bas": 93.881, "son": 95.104, "metin": "başına bir projedir."}, {"bas": 95.104, "son": 97.304, "metin": "Kanatlar uzatılabilir özel dorselere"}, {"bas": 97.304, "son": 99.688, "metin": "yüklenir; dorse yükün boyuna göre uzar."}, {"bas": 99.688, "son": 102.071, "metin": "Köprüler, virajlar ve kavşaklar önceden"}, {"bas": 102.071, "son": 104.149, "metin": "ölçülür, gerekirse güzergâh baştan"}, {"bas": 104.149, "son": 104.76, "metin": "planlanır."}, {"bas": 105.36, "son": 107.598, "metin": "Sahada önce yüzlerce ton betonla temel"}, {"bas": 107.598, "son": 109.247, "metin": "dökülür ve ankraj civataları"}, {"bas": 109.247, "son": 111.19, "metin": "yerleştirilir. Kule bölümleri dev"}, {"bas": 111.19, "son": 113.193, "metin": "paletli vinçlerle tek tek üst üste"}, {"bas": 113.193, "son": 115.489, "metin": "dizilir. Ardından nasel, sonra göbek ve"}, {"bas": 115.489, "son": 117.668, "metin": "kanatlardan oluşan rotor doksan metre"}, {"bas": 117.668, "son": 118.964, "metin": "yüksekliğe kaldırılır."}, {"bas": 118.964, "son": 121.26, "metin": "Bu türbinde kule tek başına yaklaşık üç"}, {"bas": 121.26, "son": 122.32, "metin": "yüz kırk yedi ton."}, {"bas": 122.92, "son": 125.104, "metin": "Rüzgâr kanada çarptığında, kanadın iki"}, {"bas": 125.104, "son": 127.057, "metin": "yüzü arasında basınç farkı oluşur."}, {"bas": 127.057, "son": 129.125, "metin": "Bu kaldırma kuvveti rotoru döndürür."}, {"bas": 129.125, "son": 131.251, "metin": "Dönüş şanzımandan jeneratöre geçer ve"}, {"bas": 131.251, "son": 133.549, "metin": "elektriğe dönüşür. Güç çevirici frekansı"}, {"bas": 133.549, "son": 135.388, "metin": "şebekeye uydurur, trafo gerilimi"}, {"bas": 135.388, "son": 137.398, "metin": "yükseltir. Elektrik kulenin içinden"}, {"bas": 137.398, "son": 139.007, "metin": "aşağı iner ve şebekeye akar."}, {"bas": 139.607, "son": 141.494, "metin": "Türbin kendini sürekli ayarlar."}, {"bas": 141.494, "son": 143.929, "metin": "Rüzgâr yön değiştirdiğinde yaw motorları"}, {"bas": 143.929, "son": 145.329, "metin": "naseli rüzgâra çevirir."}, {"bas": 145.329, "son": 147.459, "metin": "Rüzgâr anma hızını geçince kanatlar"}, {"bas": 147.459, "son": 149.712, "metin": "kendi eksenleri etrafında döner; buna"}, {"bas": 149.712, "son": 152.086, "metin": "pitch denir ve fazla gücü boşa çıkarır."}, {"bas": 152.086, "son": 154.521, "metin": "Rüzgâr saniyede yirmi beş metreyi aşarsa"}, {"bas": 154.521, "son": 156.834, "metin": "kanatlar rüzgâra paralel konuma gelir,"}, {"bas": 156.834, "son": 158.782, "metin": "rotor yavaşlar ve türbin kendini"}, {"bas": 158.782, "son": 159.634, "metin": "korumaya alır."}, {"bas": 160.234, "son": 162.373, "metin": "Yakıt yok, duman yok; sadece hareket"}, {"bas": 162.373, "son": 164.454, "metin": "eden hava. Enerji Üretim Kaynakları"}, {"bas": 164.454, "son": 166.474, "metin": "serisinin sıradaki bölümünde suyun"}, {"bas": 166.474, "son": 167.722, "metin": "gücünü inceleyeceğiz."}, {"bas": 167.722, "son": 169.981, "metin": "Beğenmeyi ve Kozmos Lab'e abone olmayı"}, {"bas": 169.981, "son": 170.397, "metin": "unutma!"}], "gecis": "flas", "toplam": 173.997, "dil": "tr", "olcek": 1.3333333333333333}