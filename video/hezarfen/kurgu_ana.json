{"sahneler": [{"ad": "kule", "bas": 0, "son": 7.67075}, {"ad": "deneme", "bas": 7.67075, "son": 15.663875}, {"ad": "ucus", "bas": 15.663875, "son": 21.137542}, {"ad": "sultan", "bas": 21.137542, "son": 30.446938}, {"ad": "surgun", "bas": 30.446938, "son": 39.220105}, {"ad": "soru", "bas": 39.220105, "son": 51.711355}], "altyazi": [{"bas": 0.3, "son": 2.441, "metin": "Yıl 1632 civarı,"}, {"bas": 2.441, "son": 4.776, "metin": "İstanbul. Bir adam Galata Kulesi'nin"}, {"bas": 4.776, "son": 7.111, "metin": "tepesinde. Sırtında kartal kanatları"}, {"bas": 7.111, "son": 7.371, "metin": "var."}, {"bas": 7.671, "son": 9.54, "metin": "Adı Hezarfen Ahmed Çelebi."}, {"bas": 9.54, "son": 11.697, "metin": "Hezarfen, bin fen bilen demek."}, {"bas": 11.697, "son": 14.07, "metin": "Önce Okmeydanı'nda, rüzgâra karşı"}, {"bas": 14.07, "son": 15.364, "metin": "defalarca deniyor."}, {"bas": 15.664, "son": 18.219, "metin": "Sonra lodosu bekliyor ve kendini kuleden"}, {"bas": 18.219, "son": 20.327, "metin": "bırakıyor. Altında Boğaz, karşıda"}, {"bas": 20.327, "son": 20.838, "metin": "Üsküdar."}, {"bas": 21.138, "son": 23.589, "metin": "Evliya Çelebi'ye göre Sultan Dördüncü"}, {"bas": 23.589, "son": 25.642, "metin": "Murad bu uçuşu Sarayburnu'ndaki"}, {"bas": 25.642, "son": 28.226, "metin": "köşkünden izliyor. Hezarfen, Üsküdar'da"}, {"bas": 28.226, "son": 30.147, "metin": "Doğancılar Meydanı'na iniyor."}, {"bas": 30.447, "son": 31.894, "metin": "Ödülü 1 kese altın."}, {"bas": 31.894, "son": 34.305, "metin": "Ama padişah şöyle diyor: Bu adamdan"}, {"bas": 34.305, "son": 36.785, "metin": "korkmak gerek, ne isterse yapabilir."}, {"bas": 36.785, "son": 38.92, "metin": "Ve onu Cezayir'e sürgün ediyor."}, {"bas": 39.22, "son": 40.67, "metin": "Peki gerçekten uçtu mu?"}, {"bas": 40.67, "son": 43.129, "metin": "Bu hikâyenin tek kaynağı Evliya Çelebi."}, {"bas": 43.129, "son": 45.461, "metin": "Bilim insanlarına göre kanat çırparak"}, {"bas": 45.461, "son": 47.29, "metin": "değil, ancak süzülerek mümkün"}, {"bas": 47.29, "son": 48.929, "metin": "olabilirdi. Sence uçtu mu?"}, {"bas": 48.929, "son": 49.811, "metin": "Yorumlara yaz."}], "gecis": "kara", "toplam": 51.711, "dil": "tr"}