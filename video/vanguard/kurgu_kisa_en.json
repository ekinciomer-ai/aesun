{"sahneler": [{"ad": "hero", "bas": 0, "son": 5.3704790000000004}, {"ad": "yakin", "bas": 5.3704790000000004, "son": 10.377333}, {"ad": "sinyal", "bas": 10.377333, "son": 17.836791}, {"ad": "yorunge", "bas": 17.836791, "son": 25.976854000000003}, {"ad": "gelecek", "bas": 25.976854000000003, "son": 31.260792000000006}, {"ad": "son", "bas": 31.260792000000006, "son": 37.79758400000001}], "altyazi": [{"bas": 0.4, "son": 2.627, "metin": "A satellite launched in 1958..."}, {"bas": 2.627, "son": 5.07, "metin": "is still circling above our heads!"}, {"bas": 5.37, "son": 6.691, "metin": "Its name is Vanguard 1."}, {"bas": 6.691, "son": 8.413, "metin": "The first satellite to get its"}, {"bas": 8.413, "son": 10.077, "metin": "electricity from solar cells."}, {"bas": 10.377, "son": 12.384, "metin": "This tiny sphere, about the size of a"}, {"bas": 12.384, "son": 14.337, "metin": "grapefruit, kept sending signals for"}, {"bas": 14.337, "son": 16.127, "metin": "more than six years thanks to its"}, {"bas": 16.127, "son": 17.537, "metin": "solar-powered transmitter."}, {"bas": 17.837, "son": 20.564, "metin": "Its signals went silent in 1964, but the"}, {"bas": 20.564, "son": 21.995, "metin": "satellite never fell."}, {"bas": 21.995, "son": 24.586, "metin": "Today it's still the oldest human-made"}, {"bas": 24.586, "son": 25.677, "metin": "object in orbit."}, {"bas": 25.977, "son": 28.205, "metin": "Calculations say it won't re-enter the"}, {"bas": 28.205, "son": 30.492, "metin": "atmosphere until the late twenty-second"}, {"bas": 30.492, "son": 30.961, "metin": "century."}, {"bas": 31.261, "son": 33.216, "metin": "The space adventure of solar panels"}, {"bas": 33.216, "son": 34.892, "metin": "began with this little sphere."}, {"bas": 34.892, "son": 35.898, "metin": "Follow Kozmos Lab!"}], "gecis": "flas", "toplam": 37.798, "dil": "en"}