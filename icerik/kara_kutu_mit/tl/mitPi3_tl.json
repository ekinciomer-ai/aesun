, "tüm çağrılar içindeki<br>payı düşünüldüğünde,"], [48.22, 50.41, "bu tazminatsız çıkarmayı<br>gerektirmez."], [50.41, 52.96, "Temsilci kıdem ve ihbar<br>tazminatını alacak."], [52.96, 53.85, "Yargıtay onadı."], [54.05, 56.67, "Tazminatsız çıkarmak<br>için hata demek yetmez."], [56.67, 58.21, "İşveren bunu ispat<br>etmeli,"], [58.21, 59.4, "hata da ağır olmalı."], [59.4, 60.76, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.040839, 11.892041, 19.188005000000004, 29.754264000000006, 38.073425, 54.051995999999995]}