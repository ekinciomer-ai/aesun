{"sahneler": [{"ad": "s0", "bas": 0, "son": 5.668417}, {"ad": "s1", "bas": 5.668417, "son": 11.24848}, {"ad": "s2", "bas": 11.24848, "son": 18.004543}, {"ad": "s3", "bas": 18.004543, "son": 25.104606}, {"ad": "s4", "bas": 25.104606, "son": 31.072731}], "altyazi": [{"bas": 0.4, "son": 2.211, "metin": "Bir tarlayı ilaçlamak için traktöre"}, {"bas": 2.211, "son": 3.919, "metin": "gerek kalmadı! Bu dev drone, kırk"}, {"bas": 3.919, "son": 5.368, "metin": "litrelik tankla havalanıyor."}, {"bas": 5.668, "son": 7.78, "metin": "Dört kolda, çift çift dizilmiş sekiz"}, {"bas": 7.78, "son": 10.068, "metin": "pervane. Hepsi açıldığında genişliği üç"}, {"bas": 10.068, "son": 10.948, "metin": "metreyi aşıyor!"}, {"bas": 11.248, "son": 13.575, "metin": "Altındaki pompa dakikada on altı litreye"}, {"bas": 13.575, "son": 14.68, "metin": "kadar ilaç basıyor."}, {"bas": 14.68, "son": 16.774, "metin": "Tek geçişte on bir metreye kadar bir"}, {"bas": 16.774, "son": 17.705, "metin": "şeridi kaplıyor."}, {"bas": 18.005, "son": 19.963, "metin": "Peki tarlanın inişini çıkışını nasıl"}, {"bas": 19.963, "son": 21.976, "metin": "biliyor? Önde ve arkada radarlar var."}, {"bas": 21.976, "son": 24.097, "metin": "Elli dereceye kadar eğimde bile araziyi"}, {"bas": 24.097, "son": 24.805, "metin": "takip ediyor."}, {"bas": 25.105, "son": 27.139, "metin": "Peki drone'lar güneş santrallerinde ne"}, {"bas": 27.139, "son": 29.173, "metin": "iş yapıyor? Cevap bir sonraki videoda!"}], "gecis": "flas", "toplam": 31.073, "dil": "tr"}