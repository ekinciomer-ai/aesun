{"toplam": 78.812, "dil": "tr", "parca": {"V1": [0.45, 5.115], "V2": [5.115, 16.174], "V3": [16.174, 25.247], "V4": [25.247, 36.751], "V5": [36.751, 47.656], "V6": [47.656, 63.914], "V7": [63.914, 78.812]}, "sayac": [33.651, 36.651], "altyazi": [{"bas": 0.45, "son": 2.129, "metin": "Kavşağa önce giren geçer."}, {"bas": 2.129, "son": 3.405, "metin": "Herkes böyle bilir."}, {"bas": 3.405, "son": 4.815, "metin": "Peki mahkeme ne dedi?"}, {"bas": 5.115, "son": 6.69, "metin": "Şehir içinde bir kavşak."}, {"bas": 6.69, "son": 9.117, "metin": "Hava açık, yol kuru, hız sınırı elli."}, {"bas": 9.117, "son": 11.347, "metin": "Bir kamyonet yan sokaktan geliyor."}, {"bas": 11.347, "son": 13.119, "metin": "Köşede bir DUR levhası var."}, {"bas": 13.119, "son": 15.874, "metin": "Sağ taraftan da bir motosiklet yaklaşıyor."}, {"bas": 16.174, "son": 18.415, "metin": "Kamyonet durmuyor, kavşağa giriyor."}, {"bas": 18.415, "son": 20.592, "metin": "Motosiklet de yavaşlamadan kavşağa"}, {"bas": 20.592, "son": 22.065, "metin": "giriyor. Çarpışıyorlar."}, {"bas": 22.065, "son": 24.306, "metin": "Motosikletlinin kemiği ağır şekilde"}, {"bas": 24.306, "son": 24.947, "metin": "kırılıyor."}, {"bas": 25.247, "son": 26.84, "metin": "Sence kim kusurlu?"}, {"bas": 26.84, "son": 28.522, "metin": "A, sadece kamyonet."}, {"bas": 28.522, "son": 30.38, "metin": "B, sadece motosiklet."}, {"bas": 30.38, "son": 33.301, "metin": "C, ikisi de. Cevabını yoruma yaz."}, {"bas": 36.751, "son": 38.584, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 38.584, "son": 40.941, "metin": "kamyonetin önünde DUR levhası vardı."}, {"bas": 40.941, "son": 43.69, "metin": "İkinci ipucu: motosiklet sağdan geliyordu."}, {"bas": 43.69, "son": 45.785, "metin": "Üçüncü ipucu: motosiklet kavşağa"}, {"bas": 45.785, "son": 47.356, "metin": "yaklaşırken yavaşlamadı."}, {"bas": 47.656, "son": 49.141, "metin": "Bilirkişi raporları net."}, {"bas": 49.141, "son": 51.677, "metin": "Kamyonet sürücüsü DUR levhasında durmadı,"}, {"bas": 51.677, "son": 53.037, "metin": "geçiş hakkını vermedi:"}, {"bas": 53.037, "son": 55.511, "metin": "asli kusurlu. Dört bin beş yüz lira adli"}, {"bas": 55.511, "son": 58.109, "metin": "para cezası, ehliyeti dört ay geri alındı."}, {"bas": 58.109, "son": 60.336, "metin": "Ama geçiş hakkı olan motosikletli de"}, {"bas": 60.336, "son": 62.315, "metin": "yavaşlamadığı için tali kusurlu."}, {"bas": 62.315, "son": 63.614, "metin": "Yargıtay hükmü onadı."}, {"bas": 63.914, "son": 66.471, "metin": "Yasada kavşağa önce giren geçer diye bir"}, {"bas": 66.471, "son": 68.773, "metin": "kural yok. Sırayı levha, ışık ve yol"}, {"bas": 68.773, "son": 71.202, "metin": "belirler. İşaret yoksa soldaki, sağdan"}, {"bas": 71.202, "son": 72.289, "metin": "gelene yol verir."}, {"bas": 72.289, "son": 74.974, "metin": "Geçiş hakkın olsa bile kavşakta yavaşlamak"}, {"bas": 74.974, "son": 77.212, "metin": "zorundasın. Sen hangi şıkkı seçtin?"}], "carp": 21.301, "tali": 58.134, "onayT": 62.349, "ip": [37.646, 40.968, 43.779]}