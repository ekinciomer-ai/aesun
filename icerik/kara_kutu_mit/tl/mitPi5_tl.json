, 41.26, "Mahkeme dedi ki:"], [41.26, 42.76, "Israrlı takip ve<br>mesajlar,"], [42.76, 45.25, "kadın çalışanlarda korku<br>ve endişe yarattı."], [45.25, 46.76, "Bu, haklı fesih<br>sebebidir."], [46.76, 48.43, "Kıdem ve ihbar tazminatı<br>yok."], [48.43, 50.74, "Sadece kullanılmayan<br>izinlerinin parası"], [50.74, 51.27, "ödenecek."], [51.27, 52.14, "Yargıtay onadı."], [52.34, 54.75, "Kıdem, iş arkadaşlarını<br>rahatsız etme hakkı"], [54.75, 55.14, "vermez."], [55.14, 56.02, "Hayır, hayırdır."], [56.02, 57.29, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.5892290000000004, 10.927211000000002, 20.290726000000006, 31.86503400000001, 40.335125000000005, 52.335624]}