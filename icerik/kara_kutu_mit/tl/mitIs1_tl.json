.45, 62.14, "çünkü kemer verilmeden<br>kasaya çıktı ve"], [62.14, 64.91, "çalışmaktan kaçınma<br>hakkını kullanmadı."], [64.91, 68.14, "İşveren, 840.314 TL<br>maddi,"], [68.14, 70.8, "100.000 TL manevi<br>tazminat ödeyecek."], [70.8, 71.85, "Yargıtay onadı."], [72.45, 75.77, "Eğitim vermek, işverenin<br>önlem alma borcunu"], [75.77, 76.47, "bitirmez."], [76.47, 78.82, "Kemer yoksa, yaşam hattı<br>yoksa,"], [78.82, 81.7, "bu şartlarda çalışmam<br>deme hakkın var."], [81.7, 83.44, "Sen hangi şıkkı seçtin?"]], "_starts": [0.3, 9.535624, 18.360567, 26.960862, 38.866168, 50.753311000000004, 72.45328800000001]}