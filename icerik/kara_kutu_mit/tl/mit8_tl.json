{"kaza": 7.71551, "poll": 22.733378, "cd0": 24.233378, "rew": 30.326121999999998, "rewDur": 1.3, "slow": 31.626122, "karar": 41.315532, "ders": 53.818253, "next": 57.1, "end": 62.005872000000004, "suc": 999, "cut": 999, "map": [[7.71551, 1.6], [14.276961, 3.6], [18.576961, 7.0], [22.733378, 8.6]], "_imp": 18.576961, "rwTo": 3.3, "slowRate": 0.3715396499890087, "clues": [[32.826122, "Işık araca yeşil, evet"], [35.226122, "Ama kavşağa hızlı yaklaşıyor"], [37.426122, "Geçitteki yayayı hesaba katmıyor"]], "reasons": [[42.7, "Asıl kusur: kırmızıda geçen yaya"], [45.2, "Sürücü hızlı yaklaştı → tali kusurlu"], [48.8, "Taksirle yaralama: mahkûm, ceza ertelendi"]], "hukum": 50.3, "onay": 52.3, "caps": [[0.3, 1.98, "Yeşil ışıkta geçiyorsan,"], [1.98, 4.42, "ne olursa olsun<br>suçlu sen olmazsın."], [4.42, 5.75, "Herkes böyle bilir."], [5.75, 7.22, "Peki mahkeme ne dedi?"], [7.92, 10.56, "Gündüz, şehir içinde<br>ışıklı bir kavşak."], [10.56, 14.03, "Sürücüye yeşil yanıyor ve<br>kavşağa hızla yaklaşıyor."], [14.28, 15.49, "O sırada bir yaya,"], [15.49, 19.45, "kendisine kırmızı yanarken yaya<br>geçidinden karşıya geçiyor."], [19.45, 22.53, "Araç yayaya çarpıyor ve<br>yaya ağır yaralanıyor."], [22.93, 26.55, "Sizce yeşilde geçen<br>sürücüye ne oldu?"], [26.55, 29.98, "A, B, yoksa C?<br>Cevabını yoruma yaz."], [31.83, 34.6, "Geri saralım. Işık<br>sürücüye yeşil, evet."], [34.6, 36.67, "Ama kavşağa<br>hızlı yaklaşıyor."], [36.67, 41.02, "Önündeki yaya geçidinde birinin<br>olabileceğini hesaba katmıyor."], [41.52, 42.68, "Mahkeme dedi ki:"], [42.68, 45.14, "Asıl kusur kırmızıda<br>geçen yayada."], [45.14, 48.7, "Ama sürücü de hızlı<br>yaklaştığı için tali kusurlu."], [48.7, 51.1, "Taksirle yaralamadan<br>mahkûm oldu,"], [51.1, 52.33, "cezası ertelendi."], [52.33, 53.42, "Yargıtay onadı."], [54.02, 55.16, "Yani yeşil ışık,"], [55.16, 57.16, "dikkatsiz olma<br>hakkı vermez."], [57.16, 59.16, "Kavşağa yaklaşırken<br>yavaşla."], [59.16, 60.81, "Sen hangi şıkkı seçtin?"]], "_starts": [0