# Sunucuda /opt/sosyal/sosyal.env olarak durur. Anahtarlar burada DEĞİL, kasadan /opt/sosyal/anahtar.env'e yazılır.
SOSYAL_PAROLA=
SOSYAL_OTURUM_ANAHTARI=
SOSYAL_DENEME=0
SOSYAL_SOHBET_ARSIV_GUN=7
# Görev başına motor sırası (ilk hazır olan çalışır)
SOSYAL_ROL_ARASTIRMA=gemini
SOSYAL_ROL_FIKIR=gemini,groq,openrouter,ollama
SOSYAL_ROL_YAZAR=claude,gemini,openai,groq,openrouter,ollama
SOSYAL_ROL_ELESTIRMEN=groq,gemini,openrouter,mistral,ollama
SOSYAL_ROL_DAMITICI=gemini,claude,groq,openrouter,ollama
# Modeller (isteğe bağlı)
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# Kendi sunucumuzda Ollama varsa:
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
