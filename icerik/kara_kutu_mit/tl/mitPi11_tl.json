{"kaza": 5.853061, "poll": 19.905374000000002, "cd0": 24.906335450000004, "rew": 29.066213, "rewDur": 0.8, "slow": 29.866213000000002, "karar": 37.298004, "ders": 48.143786, "next": 51.12055135, "end": 55.49770899999999, "suc": 999, "cut": 999, "_imp": 14.464488039999999, "map": [[5.853061, 1.7999999999999998], [12.922789, 4.0], [14.464488039999999, 6.0], [19.905374000000002, 7.4]], "rwTo": 3.4, "slowRate": 0.3229369609559796, "clues": [[30.63426317021277, "Tanıklar dinleniyor"], [32.0703635106383, "Telefon kayıtları inceleniyor"], [33.81419963829788, "Şubattan beri çalışıyor"]], "reasons": [[38.321005580645156, "8 ay hizmet tescil edilecek"], [41.81236419354838, "Belge yok: asgari ücretten"]], "hukum": 45.53266435483871, "onay": 46.293786, "caps": [[0.25, 1.64, "Sigortasız çalıştıysan,"], [1.64, 3.1, "o ayları geri alamazsın."], [3.1, 4.43, "Genelde böyle bilinir."], [4.43, 5.7, "Peki mahkeme ne dedi?"], [5.9, 9.66, "Bir kadın, bir eğitim kurumunda<br>muhasebe yardımcısı olarak işe başlıyor."], [9.66, 10.81, "Maaşı elden veriliyor."], [10.81, 12.84, "Sabahları servis<br>hostesliği de yapıyor."], [12.92, 14.46, "8 ay sonra fark ediyor:"], [14.46, 15.99, "Sigortası yeni<br>başlatılmış."], [15.99, 17.47, "O 8 ay kayıtlarda yok."], [17.47, 18.44, "İşveren diyor ki:"], [18.44, 19.81, "Zaten o gün işe başladı."], [20.01, 22.83, "Sizce o 8 ay<br>sigortasına sayıldı mı?"], [22.83, 24.25, "A, hayır, kayıt yok."], [24.25, 25.8, "B, sadece son 2 ayı."], [25.8, 27.5, "C, evet, tamamı sayıldı."], [27.5, 28.92, "Cevabını yoruma yaz."], [29.92, 32.06, "Geri saralım. Mahkeme<br>tanıkları dinliyor."], [32.06, 33.79, "Telefon kayıtları<br>da inceleniyor."], [33.79, 35.21, "Hepsi aynı şeyi<br>gösteriyor:"], [35.21, 37.15, "Şubattan beri o iş<br>yerinde çalışıyor."], [37.35, 38.28, "Mahkeme dedi ki:"], [38.28, 41.79, "8 aylık çalışma sigortalı<br>hizmet olarak tescil edilecek."], [41.79, 45.54, "Maaşının yazılı belgesi olmadığı<br>için asgari ücretten sayılacak."], [45.54, 47.12, "Kurumun itirazı<br>reddedildi."], [47.12, 47.99, "Yargıtay onadı."], [48.19, 50.16, "Sigortasız geçen<br>ayların kaybolmaz."], [50.16, 53.41, "Tanıkla ve kayıtla ispat edersen<br>o süre sigortana işlenir."], [53.41, 54.7, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.903061, 12.922789, 20.005374000000003, 29.916213000000003, 37.348003999999996, 48.193785999999996]}