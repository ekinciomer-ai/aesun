{"sahneler": [{"ad": "hero", "bas": 0, "son": 7.173813}, {"ad": "dongu", "bas": 7.173813, "son": 14.424146}, {"ad": "baraj", "bas": 14.424146, "son": 20.698896}, {"ad": "boru", "bas": 20.698896, "son": 25.268959000000002}, {"ad": "turbin", "bas": 25.268959000000002, "son": 30.159022}, {"ad": "sebeke", "bas": 30.159022, "son": 38.466480000000004}, {"ad": "pompaj", "bas": 38.466480000000004, "son": 45.916543000000004}, {"ad": "dunya", "bas": 45.916543000000004, "son": 51.577668}, {"ad": "son", "bas": 51.577668, "son": 58.547731000000006}], "altyazi": [{"bas": 0.4, "son": 2.431, "metin": "Bir barajın arkasında biriken su,"}, {"bas": 2.431, "son": 4.339, "metin": "aslında devasa bir pil gibidir!"}, {"bas": 4.339, "son": 6.739, "metin": "Enerji Üretim Kaynakları, üçüncü bölüm:"}, {"bas": 6.739, "son": 6.924, "metin": "su."}, {"bas": 7.174, "son": 9.016, "metin": "Bu enerjinin kaynağı da güneş."}, {"bas": 9.016, "son": 11.104, "metin": "Güneş suyu buharlaştırır, bulutlar"}, {"bas": 11.104, "son": 13.499, "metin": "dağlara yağmur ve kar bırakır, nehirler"}, {"bas": 13.499, "son": 14.174, "metin": "aşağı akar."}, {"bas": 14.424, "son": 16.307, "metin": "Baraj nehri keser ve su yükseklerde"}, {"bas": 16.307, "son": 18.405, "metin": "birikir. Su ne kadar yüksekten düşerse,"}, {"bas": 18.405, "son": 20.449, "metin": "taşıdığı enerji de o kadar büyük olur."}, {"bas": 20.699, "son": 22.859, "metin": "Su, cebri boru denen dev borulardan"}, {"bas": 22.859, "son": 25.019, "metin": "hızla aşağı iner ve türbine çarpar."}, {"bas": 25.269, "son": 27.351, "metin": "Türbinin kanatları döner; aynı mile"}, {"bas": 27.351, "son": 29.433, "metin": "bağlı jeneratör bu dönüşü elektriğe"}, {"bas": 29.433, "son": 29.909, "metin": "çevirir."}, {"bas": 30.159, "son": 32.372, "metin": "Trafolar gerilimi yükseltir ve elektrik"}, {"bas": 32.372, "son": 34.358, "metin": "şebekeye akar. Türkiye'nin en büyük"}, {"bas": 34.358, "son": 36.457, "metin": "barajı olan Atatürk Barajı'nın kurulu"}, {"bas": 36.457, "son": 38.216, "metin": "gücü, iki bin dört yüz megavat."}, {"bas": 38.466, "son": 40.867, "metin": "Bazı santraller, elektrik bol olduğunda"}, {"bas": 40.867, "son": 42.959, "metin": "suyu yukarıdaki bir göle pompalar;"}, {"bas": 42.959, "son": 44.682, "metin": "ihtiyaç olunca geri bırakır."}, {"bas": 44.682, "son": 45.667, "metin": "Tam bir dev pil!"}, {"bas": 45.917, "son": 48.349, "metin": "Dünyanın en büyüğü ise Çin'deki Üç Boğaz"}, {"bas": 48.349, "son": 50.355, "metin": "Barajı: Kurulu gücü yirmi iki bin"}, {"bas": 50.355, "son": 51.328, "metin": "megavatı aşıyor."}, {"bas": 51.578, "son": 53.0, "metin": "Yağmurdan elektriğe!"}, {"bas": 53.0, "son": 55.133, "metin": "Sıradaki bölümde: atomun gücü."}, {"bas": 55.133, "son": 56.698, "metin": "Kozmos Lab'i takip et."}], "gecis": "flas", "toplam": 58.548, "dil": "tr"}