{"kaza": 5.860454000000001, "poll": 18.368005000000004, "cd0": 23.075658050000005, "rew": 26.995556000000004, "rewDur": 0.8, "slow": 27.795556000000005, "karar": 37.274898, "ders": 51.890431, "next": 54.8084718, "end": 59.113854999999994, "suc": 999, "cut": 999, "_imp": 16.74866356716418, "map": [[5.860454000000001, 1.7999999999999998], [10.996871, 4.0], [16.74866356716418, 6.0], [18.368005000000004, 7.4]], "rwTo": 3.4, "slowRate": 0.25318213015207186, "clues": [[28.667776177215195, "Dilekçe işe giriş günü imzalatılmış"], [32.77887706329115, "İlk mahkeme: tazminat yok"], [35.53918765822785, "Dosya istinafa gidiyor"]], "reasons": [[38.87557286454183, "Giriş günü istifa = zor durumdan yararlanma"], [45.30800193227091, "Kıdem + ihbar tazminatı ödenecek"]], "hukum": 47.662730430278884, "onay": 50.040431, "caps": [[0.25, 2.17, "İstifa dilekçesini<br>imzaladıysan,"], [2.17, 3.31, "tazminat alamazsın."], [3.31, 4.45, "Herkes böyle bilir."], [4.45, 5.71, "Peki mahkeme ne dedi?"], [5.91, 7.73, "Bir tır şoförü yeni işe<br>giriyor."], [7.73, 9.44, "Önüne bir yığın evrak<br>konuyor."], [9.44, 10.92, "Hepsini tek tek<br>imzalıyor."], [11.0, 12.77, "Beş yıl sonra işten<br>çıkarılıyor."], [12.77, 14.83, "İşveren dosyadan bir<br>kâğıt çıkarıyor:"], [14.83, 16.71, "Kendi isteğimle<br>ayrılıyorum yazan,"], [16.71, 18.27, "imzalı bir istifa<br>dilekçesi."], [18.47, 20.91, "Sizce şoför tazminatını<br>aldı mı?"], [20.91, 22.43, "A, hayır, imza onun."], [22.43, 23.72, "B, evet, aldı. C,"], [23.72, 25.32, "sadece yarısını aldı."], [25.32, 26.85, "Cevabını yoruma yaz."], [27.85, 29.29, "Geri saralım. O dilekçe,"], [29.29, 30.26, "işe girdiği gün,"], [30.26, 32.73, "giriş evraklarının<br>arasında imzalatılmış."], [32.73, 35.5, "İlk mahkeme imzaya bakıp<br>tazminatı reddediyor."], [35.5, 37.12, "Ama dosya istinafa<br>gidiyor."], [37.32, 38.85, "İstinaf mahkemesi dedi<br>ki:"], [38.85, 41.56, "İş arayan birine giriş<br>günü istifa imzalatmak,"], [41.56, 43.62, "onun zor durumundan<br>yararlanmaktır."], [43.62, 45.27, "Bu dilekçeye itibar<br>edilmez."], [45.27, 47.62, "Şoför kıdem ve ihbar<br>tazminatını alacak."], [47.62, 49.72, "İzin defteri<br>sunulamadığı için izin"], [49.72, 50.86, "ücretini de alacak."], [50.86, 51.74, "Yargıtay onadı."], [51.94, 54.35, "Mahkemeye göre, işe<br>girerken imzalatılan"], [54.35, 56.94, "istifa dilekçesi seni<br>tazminatsız bırakmaz."], [56.94, 58.31, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.9104540000000005, 10.996871, 18.468005000000005, 27.845556000000006, 37.324898, 51.940431]}