.78, "üzerinden ödenir."], [44.78, 47.29, "İzni kullandırdığını<br>ispat etmek işverene"], [47.29, 47.66, "düşer."], [47.66, 51.14, "8.943 TL izin ücretine<br>hükmedildi."], [51.14, 52.04, "Yargıtay onadı."], [52.24, 53.8, "Kullanmadığın izin<br>yanmaz,"], [53.8, 55.36, "iş bitince paraya<br>dönüşür."], [55.36, 57.75, "İzin kullandığında<br>mutlaka imzalı kayıt"], [57.75, 58.12, "olsun."], [58.12, 59.5, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.171723, 11.879093, 16.854762, 26.178753, 38.175306, 52.243151999999995]}