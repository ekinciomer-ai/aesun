{"sahneler": [{"ad": "kanca", "bas": 0, "son": 14.924854}, {"ad": "pilot", "bas": 14.924854, "son": 23.7011104}, {"ad": "cephe", "bas": 23.7011104, "son": 34.427646}, {"ad": "kacis", "bas": 34.427646, "son": 42.119693100000006}, {"ad": "nargin", "bas": 42.119693100000006, "son": 51.52108400000001}, {"ad": "kurtulus", "bas": 51.52108400000001, "son": 61.40173000000001}, {"ad": "cizim", "bas": 61.40173000000001, "son": 69.63258640000001}, {"ad": "heyet", "bas": 69.63258640000001, "son": 79.692522}, {"ad": "lisans", "bas": 79.692522, "son": 87.27850099999999}, {"ad": "ucus", "bas": 87.27850099999999, "son": 92.7030071}, {"ad": "ceza", "bas": 92.7030071, "son": 99.33295899999999}, {"ad": "kereste", "bas": 99.33295899999999, "son": 108.55620899999998}, {"ad": "prag", "bas": 108.55620899999998, "son": 117.20075099999997}, {"ad": "okul", "bas": 117.20075099999997, "son": 125.92902199999996}, {"ad": "havayolu", "bas": 125.92902199999996, "son": 131.94628159999996}, {"ad": "son", "bas": 131.94628159999996, "son": 139.30070999999995}, {"ad": "olum", "bas": 139.30070999999995, "son": 147.62089799999995}, {"ad": "bugun", "bas": 147.62089799999995, "son": 159.74931499999994}, {"ad": "cta", "bas": 159.74931499999994, "son": 167.11596099999994}], "altyazi": [{"bas": 0.4, "son": 2.784, "metin": "28 Eylül 2026."}, {"bas": 2.784, "son": 5.039, "metin": "Hava Kuvvetleri yeni eğitim uçağını"}, {"bas": 5.039, "son": 6.65, "metin": "teslim aldı. Adı: Hürkuş."}, {"bas": 6.65, "son": 8.969, "metin": "Bu isim, kendi yaptığı uçağı izinsiz"}, {"bas": 8.969, "son": 11.418, "metin": "uçurduğu için ceza alan bir adama ait."}, {"bas": 11.418, "son": 13.673, "metin": "Türkiye'nin ilk uçağını yapan adam:"}, {"bas": 13.673, "son": 14.575, "metin": "Vecihi Hürkuş."}, {"bas": 14.925, "son": 17.135, "metin": "1896, İstanbul."}, {"bas": 17.135, "son": 19.529, "metin": "Birinci Dünya Savaşı'nda Vecihi cepheye"}, {"bas": 19.529, "son": 21.002, "metin": "makinist olarak gidiyor."}, {"bas": 21.002, "son": 22.353, "metin": "Ama gözü hep yukarıda."}, {"bas": 22.353, "son": 24.624, "metin": "1916'da Yeşilköy'deki"}, {"bas": 24.624, "son": 27.08, "metin": "Tayyare Mektebi'nde ilk uçuşunu yapıyor."}, {"bas": 27.08, "son": 29.474, "metin": "1917 sonbaharı, Kafkas"}, {"bas": 29.474, "son": 31.622, "metin": "Cephesi. Bir Rus uçağını düşürüyor."}, {"bas": 31.622, "son": 33.955, "metin": "Bu cephede uçak düşüren ilk Türk pilot"}, {"bas": 33.955, "son": 34.078, "metin": "o."}, {"bas": 34.428, "son": 35.615, "metin": "Sonra şans dönüyor."}, {"bas": 35.615, "son": 37.739, "metin": "Bir hava çatışmasında yaralanıyor."}, {"bas": 37.739, "son": 40.238, "metin": "Uçağı düşmana kalmasın diye kendi eliyle"}, {"bas": 40.238, "son": 41.737, "metin": "yakıyor ve esir düşüyor."}, {"bas": 41.737, "son": 43.861, "metin": "Gönderildiği yer: Hazar Denizi'nin"}, {"bas": 43.861, "son": 45.486, "metin": "ortasında bir ada. Nargin."}, {"bas": 45.486, "son": 46.985, "metin": "Vecihi orada beklemiyor."}, {"bas": 46.985, "son": 49.484, "metin": "Azerbaycan Türklerinin yardımıyla denize"}, {"bas": 49.484, "son": 51.171, "metin": "giriyor ve yüzerek kaçıyor."}, {"bas": 51.521, "son": 53.585, "metin": "Kurtuluş Savaşı'nda keşif uçuşları"}, {"bas": 53.585, "son": 55.71, "metin": "yapıyor, bir Yunan uçağı düşürüyor."}, {"bas": 55.71, "son": 57.895, "metin": "Meclis'ten 3 kez takdirname alıyor,"}, {"bas": 57.895, "son": 59.838, "metin": "göğsüne kırmızı şeritli İstiklal"}, {"bas": 59.838, "son": 61.052, "metin": "Madalyası takılıyor."}, {"bas": 61.402, "son": 63.857, "metin": "Savaş bitince aklında tek bir soru var:"}, {"bas": 63.857, "son": 66.186, "metin": "Biz neden kendi uçağımızı yapmıyoruz?"}, {"bas": 66.186, "son": 68.641, "metin": "14 Haziran 1923."}, {"bas": 68.641, "son": 71.159, "metin": "Çizimler hazır. İzmir'de, savaştan kalan"}, {"bas": 71.159, "son": 73.488, "metin": "malzemelerle bir uçak çıkıyor ortaya:"}, {"bas": 73.488, "son": 75.628, "metin": "Vecihi K-VI. Ama bir sorun var."}, {"bas": 75.628, "son": 77.643, "metin": "Uçağı onaylayacak heyette, uçağı"}, {"bas": 77.643, "son": 79.343, "metin": "denetleyebilecek kimse yok."}, {"bas": 79.693, "son": 82.215, "metin": "Heyetten biri şöyle diyor: Vecihi, biz"}, {"bas": 82.215, "son": 83.941, "metin": "sana bu lisansı veremeyiz."}, {"bas": 83.941, "son": 86.464, "metin": "Uçağına güveniyorsan atla, uç, bizi de"}, {"bas": 86.464, "son": 86.929, "metin": "kurtar."}, {"bas": 87.279, "son": 89.428, "metin": "28 Ocak 1925,"}, {"bas": 89.428, "son": 91.399, "metin": "saat 15.00. Vecihi havalanıyor."}, {"bas": 91.399, "son": 93.608, "metin": "15 dakika. Türkiye'de yapılan bir"}, {"bas": 93.608, "son": 94.803, "metin": "uçağın ilk uçuşu bu."}, {"bas": 94.803, "son": 96.953, "metin": "Karşılığı? İzinsiz uçtuğu için ceza."}, {"bas": 96.953, "son": 98.983, "metin": "Uçağını da bir daha geri alamıyor."}, {"bas": 99.333, "son": 100.472, "metin": "Vecihi pes etmiyor."}, {"bas": 100.472, "son": 102.57, "metin": "1930'da Kadıköy'de bir"}, {"bas": 102.57, "son": 104.249, "metin": "keresteci dükkânı kiralıyor."}, {"bas": 104.249, "son": 106.527, "metin": "Üç ayda yeni bir uçak: Vecihi XIV."}, {"bas": 106.527, "son": 108.206, "metin": "Türkiye'nin ilk sivil uçağı."}, {"bas": 108.556, "son": 110.752, "metin": "Yine onay yok. Bu kez uçağı söküyor,"}, {"bas": 110.752, "son": 112.338, "metin": "Çekoslovakya'ya götürüyor."}, {"bas": 112.338, "son": 113.496, "metin": "Onayı orada alıyor."}, {"bas": 113.496, "son": 115.692, "metin": "1931'de aynı uçakla"}, {"bas": 115.692, "son": 116.851, "metin": "uçarak eve dönüyor."}, {"bas": 117.201, "son": 119.465, "metin": "1932'de Türkiye'nin ilk"}, {"bas": 119.465, "son": 121.22, "metin": "sivil havacılık okulunu açıyor."}, {"bas": 121.22, "son": 123.258, "metin": "Öğrencileri arasında Türkiye'nin ilk"}, {"bas": 123.258, "son": 125.353, "metin": "kadın pilotlarından Bedriye Gökmen de"}, {"bas": 125.353, "son": 125.579, "metin": "var."}, {"bas": 125.929, "son": 128.13, "metin": "1954'te kendi hava"}, {"bas": 128.13, "son": 130.27, "metin": "yolu şirketini kuruyor: Hürkuş Hava"}, {"bas": 130.27, "son": 132.47, "metin": "Yolları. Uçak alıyor, ama izinler ve"}, {"bas": 132.47, "son": 134.427, "metin": "engeller bitmiyor. Şirket ayakta"}, {"bas": 134.427, "son": 136.75, "metin": "kalamıyor. Son yıllarını maddi sıkıntı"}, {"bas": 136.75, "son": 138.951, "metin": "içinde, anılarını yazarak geçiriyor."}, {"bas": 139.301, "son": 141.587, "metin": "16 Temmuz 1969."}, {"bas": 141.587, "son": 144.135, "metin": "İnsanlık Ay'a doğru yola çıktığı"}, {"bas": 144.135, "son": 146.552, "metin": "gün, Vecihi Hürkuş Ankara'da hayatını"}, {"bas": 146.552, "son": 147.271, "metin": "kaybediyor."}, {"bas": 147.621, "son": 149.942, "metin": "Ve bugün, Türk Hava Kuvvetleri'nin pilot"}, {"bas": 149.942, "son": 152.205, "metin": "adaylarını yetiştireceği uçağın üstünde"}, {"bas": 152.205, "son": 154.409, "metin": "onun adı yazıyor. 2028'e"}, {"bas": 154.409, "son": 155.686, "metin": "kadar 55 Hürkuş."}, {"bas": 155.686, "son": 157.833, "metin": "Bir zamanlar izinsiz uçan adam, şimdi"}, {"bas": 157.833, "son": 159.399, "metin": "pilotlara uçmayı öğretiyor."}, {"bas": 159.749, "son": 162.03, "metin": "Sence Vecihi'nin hikâyesi okullarda"}, {"bas": 162.03, "son": 163.854, "metin": "neden daha çok anlatılmıyor?"}, {"bas": 163.854, "son": 164.766, "metin": "Yorumlara yaz."}], "gecis": "kara", "toplam": 167.116, "dil": "tr"}