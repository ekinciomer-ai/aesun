{"toplam": 63.96, "dil": "tr", "parca": {"V1": [0.35, 5.465], "V2": [5.465, 12.392], "V3": [12.392, 21.293], "V4": [21.293, 31.983], "V5": [31.983, 43.688], "V6": [43.688, 56.539], "V7": [56.539, 63.96]}, "sayac": [29.383, 31.883], "altyazi": [{"bas": 0.35, "son": 1.546, "metin": "Kaza yaptın, kaçtın."}, {"bas": 1.546, "son": 2.922, "metin": "En fazla bir ceza daha."}, {"bas": 2.922, "son": 4.059, "metin": "Herkes böyle bilir."}, {"bas": 4.059, "son": 5.315, "metin": "Peki mahkeme ne dedi?"}, {"bas": 5.465, "son": 6.766, "metin": "Gece, iki yönlü bir yol."}, {"bas": 6.766, "son": 8.122, "metin": "Ortada devamlı çizgi var."}, {"bas": 8.122, "son": 9.369, "metin": "Bir kamyonet ilerliyor."}, {"bas": 9.369, "son": 11.212, "metin": "Karşıdan, arkasında yolcusuyla bir"}, {"bas": 11.212, "son": 12.242, "metin": "motosiklet geliyor."}, {"bas": 12.392, "son": 14.204, "metin": "Kamyonet çizgiyi geçip karşı şeride"}, {"bas": 14.204, "son": 15.395, "metin": "giriyor. Çarpışıyorlar."}, {"bas": 15.395, "son": 17.311, "metin": "Kamyonet birkaç saniye duruyor, sonra"}, {"bas": 17.311, "son": 19.227, "metin": "kaçıyor. Motosiklet sürücüsü hayatını"}, {"bas": 19.227, "son": 21.143, "metin": "kaybediyor, yolcusu ağır yaralanıyor."}, {"bas": 21.293, "son": 23.66, "metin": "Sence kaçmak sürücüye ne kazandırdı?"}, {"bas": 23.66, "son": 25.041, "metin": "A, hiçbir şey olmadı."}, {"bas": 25.041, "son": 26.619, "metin": "B, sadece trafik cezası."}, {"bas": 26.619, "son": 27.868, "metin": "C, dokuz yıl hapis."}, {"bas": 27.868, "son": 29.183, "metin": "Cevabını yoruma yaz."}, {"bas": 31.983, "son": 33.561, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 33.561, "son": 35.196, "metin": "sürücü devamlı çizgiyi geçti."}, {"bas": 35.196, "son": 37.281, "metin": "İkinci ipucu: kaçtı ama üç saat sonra"}, {"bas": 37.281, "son": 39.423, "metin": "alkolü ölçüldü. Bir virgül doksan altı"}, {"bas": 39.423, "son": 40.607, "metin": "promil. Üçüncü ipucu:"}, {"bas": 40.607, "son": 42.749, "metin": "daha önce de alkollü araç kullanmaktan"}, {"bas": 42.749, "son": 43.538, "metin": "hüküm almıştı."}, {"bas": 43.688, "son": 46.099, "metin": "Mahkeme alkolü kaza anına geri hesapladı:"}, {"bas": 46.099, "son": 47.98, "metin": "yaklaşık iki virgül dört promil."}, {"bas": 47.98, "son": 49.156, "metin": "Sürücü asli kusurlu."}, {"bas": 49.156, "son": 50.332, "metin": "Temel ceza altı yıl."}, {"bas": 50.332, "son": 52.331, "metin": "Bilinçli taksirle dokuz yıl hapis."}, {"bas": 52.331, "son": 53.86, "metin": "İndirim yok, erteleme yok."}, {"bas": 53.86, "son": 55.507, "metin": "Ehliyeti üç yıl geri alındı."}, {"bas": 55.507, "son": 56.389, "metin": "Yargıtay onadı."}, {"bas": 56.539, "son": 57.772, "metin": "Yani kaçmak kurtarmaz."}, {"bas": 57.772, "son": 59.621, "metin": "Alkol saatler sonra bile ölçülür."}, {"bas": 59.621, "son": 61.471, "metin": "Kaza yaptıysan dur, yardım çağır."}, {"bas": 61.471, "son": 62.76, "metin": "Sen hangi şıkkı seçtin?"}], "carp": 14.818, "tali": 49.155, "onayT": 55.591, "ip": [32.749, 35.214, 39.923]}