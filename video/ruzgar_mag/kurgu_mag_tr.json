{"sahneler": [{"ad": "mhero", "bas": 0, "son": 5.660063}, {"ad": "mkanat", "bas": 5.660063, "son": 13.240126}, {"ad": "malan", "bas": 13.240126, "son": 20.100189}, {"ad": "mkarsi", "bas": 20.100189, "son": 27.742272}, {"ad": "muretim", "bas": 27.742272, "son": 36.282334999999996}, {"ad": "mson", "bas": 36.282334999999996, "son": 41.82239799999999}], "altyazi": [{"bas": 0.4, "son": 2.82, "metin": "Biliyor muydun? Dünyanın en güçlü rüzgâr"}, {"bas": 2.82, "son": 4.876, "metin": "türbinlerinden biri tam yirmi altı"}, {"bas": 4.876, "son": 5.36, "metin": "megavat!"}, {"bas": 5.66, "son": 7.851, "metin": "Çinli Dongfang Electric'in bu test"}, {"bas": 7.851, "son": 10.17, "metin": "türbininde tek bir kanat yüz elli üç"}, {"bas": 10.17, "son": 12.618, "metin": "metre. Yani bir futbol sahasından bile"}, {"bas": 12.618, "son": 12.94, "metin": "uzun."}, {"bas": 13.24, "son": 14.865, "metin": "Rotor çapı üç yüz on metre."}, {"bas": 14.865, "son": 17.272, "metin": "Kanatların taradığı alan yetmiş yedi bin"}, {"bas": 17.272, "son": 19.439, "metin": "metrekare; yaklaşık on futbol sahası"}, {"bas": 19.439, "son": 19.8, "metin": "kadar."}, {"bas": 20.1, "son": 22.165, "metin": "Bölümde incelediğimiz beş megavatlık"}, {"bas": 22.165, "son": 24.402, "metin": "referans türbinin rotoru yüz yirmi altı"}, {"bas": 24.402, "son": 26.525, "metin": "metreydi. Bu dev, ondan neredeyse iki"}, {"bas": 26.525, "son": 27.442, "metin": "buçuk kat geniş."}, {"bas": 27.742, "son": 29.863, "metin": "Üreticiye göre ortalama saniyede on"}, {"bas": 29.863, "son": 31.741, "metin": "metre rüzgârda yılda yüz milyon"}, {"bas": 31.741, "son": 33.135, "metin": "kilovatsaat üretebilir."}, {"bas": 33.135, "son": 35.376, "metin": "Bu, yaklaşık elli beş bin evin yıllık"}, {"bas": 35.376, "son": 35.982, "metin": "elektriği."}, {"bas": 36.282, "son": 38.482, "metin": "Rüzgârın devleri büyümeye devam ediyor."}, {"bas": 38.482, "son": 39.722, "metin": "Kozmos Lab'i takip et!"}], "gecis": "flas", "toplam": 41.822, "dil": "tr", "olcek": 1.3333333333333333}