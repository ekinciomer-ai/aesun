{"sahneler": [{"ad": "hero", "bas": 0, "son": 18.618229}, {"ad": "kuvars", "bas": 18.618229, "son": 47.396687}, {"ad": "firin", "bas": 47.396687, "son": 84.89675000000001}, {"ad": "siemens", "bas": 84.89675000000001, "son": 119.11681300000002}, {"ad": "kutuk", "bas": 119.11681300000002, "son": 158.21060500000002}, {"ad": "dilim", "bas": 158.21060500000002, "son": 190.110668}, {"ad": "hucre", "bas": 190.110668, "son": 237.199876}, {"ad": "panel", "bas": 237.199876, "son": 279.33993899999996}, {"ad": "nakliye", "bas": 279.33993899999996, "son": 302.824106}, {"ad": "montaj", "bas": 302.824106, "son": 339.36416899999995}, {"ad": "uretim", "bas": 339.36416899999995, "son": 371.1419609999999}, {"ad": "son", "bas": 371.1419609999999, "son": 404.3821489999999}], "altyazi": [{"bas": 0.8, "son": 2.605, "metin": "Çatılarda, tarlalarda, çöllerde"}, {"bas": 2.605, "son": 4.294, "metin": "gördüğümüz güneş panelleri..."}, {"bas": 4.294, "son": 6.157, "metin": "aslında bir avuç kumla başlıyor."}, {"bas": 6.157, "son": 8.136, "metin": "Bugün bir panelin yolculuğunu, taş"}, {"bas": 8.136, "son": 10.116, "metin": "ocağından şebekeye kadar adım adım"}, {"bas": 10.116, "son": 11.863, "metin": "izleyeceğiz. Hangi fırınlardan"}, {"bas": 11.863, "son": 13.61, "metin": "geçtiğini, ne kadar saf olması"}, {"bas": 13.61, "son": 15.822, "metin": "gerektiğini ve sahaya nasıl ulaştığını"}, {"bas": 15.822, "son": 17.918, "metin": "göreceksiniz. Hazırsanız başlayalım."}, {"bas": 18.618, "son": 20.668, "metin": "Yolculuk bir taş ocağında başlar."}, {"bas": 20.668, "son": 22.283, "metin": "Panelin kalbi silisyumdur."}, {"bas": 22.283, "son": 24.644, "metin": "Silisyum, yer kabuğunun yaklaşık yüzde"}, {"bas": 24.644, "son": 26.88, "metin": "yirmi sekizini oluşturur; oksijenden"}, {"bas": 26.88, "son": 28.868, "metin": "sonra en bol bulunan elementtir."}, {"bas": 28.868, "son": 30.732, "metin": "Ama doğada saf hâlde bulunmaz."}, {"bas": 30.732, "son": 32.782, "metin": "Kuvarsın, yani silisyum dioksitin"}, {"bas": 32.782, "son": 34.832, "metin": "içinde, oksijene sıkıca bağlıdır."}, {"bas": 34.832, "son": 36.882, "metin": "Her kuvars da işe yaramaz: Demir,"}, {"bas": 36.882, "son": 39.304, "metin": "alüminyum gibi yabancı maddeleri çok az"}, {"bas": 39.304, "son": 41.665, "metin": "olan, yüksek saflıkta kuvars yatakları"}, {"bas": 41.665, "son": 44.088, "metin": "aranır. Taş çıkarılır, kırılır, yıkanır"}, {"bas": 44.088, "son": 46.386, "metin": "ve elenir. İlk hammadde böylece hazır"}, {"bas": 46.386, "son": 46.697, "metin": "olur."}, {"bas": 47.397, "son": 49.486, "metin": "Kırılan kuvars, kömür, kok ve odun"}, {"bas": 49.486, "son": 51.513, "metin": "yongası gibi karbon kaynaklarıyla"}, {"bas": 51.513, "son": 53.725, "metin": "birlikte dev bir ark fırınına girer."}, {"bas": 53.725, "son": 55.752, "metin": "Fırının içine sarkan kalın karbon"}, {"bas": 55.752, "son": 57.841, "metin": "elektrotlar arasında elektrik arkı"}, {"bas": 57.841, "son": 59.991, "metin": "oluşur ve sıcaklık iki bin dereceye"}, {"bas": 59.991, "son": 61.896, "metin": "yaklaşır. Bu sıcaklıkta karbon,"}, {"bas": 61.896, "son": 64.107, "metin": "kuvarstaki oksijeni koparır; oksijen"}, {"bas": 64.107, "son": 66.319, "metin": "karbon monoksit olarak gaza karışır."}, {"bas": 66.319, "son": 68.101, "metin": "Geriye erimiş silisyum kalır."}, {"bas": 68.101, "son": 70.312, "metin": "Fırının dibinden alınan bu silisyuma"}, {"bas": 70.312, "son": 72.524, "metin": "metalurjik silisyum denir ve saflığı"}, {"bas": 72.524, "son": 74.428, "metin": "yaklaşık yüzde doksan sekizdir."}, {"bas": 74.428, "son": 76.64, "metin": "Bu süreç çok büyük miktarda elektrik"}, {"bas": 76.64, "son": 78.606, "metin": "harcar. Ve elde edilen silisyum,"}, {"bas": 78.606, "son": 80.941, "metin": "alüminyum alaşımları için yeterli olsa"}, {"bas": 80.941, "son": 82.968, "metin": "da... bir güneş hücresi için hâlâ"}, {"bas": 82.968, "son": 84.197, "metin": "fazlasıyla kirlidir."}, {"bas": 84.897, "son": 86.801, "metin": "Saflığı artırmanın en yaygın yolu"}, {"bas": 86.801, "son": 87.897, "metin": "Siemens yöntemidir."}, {"bas": 87.897, "son": 89.801, "metin": "Metalurjik silisyum önce hidrojen"}, {"bas": 89.801, "son": 91.993, "metin": "klorürle tepkimeye sokulur ve sıvı bir"}, {"bas": 91.993, "son": 94.185, "metin": "bileşiğe, triklorosilana dönüştürülür."}, {"bas": 94.185, "son": 96.32, "metin": "Bu sıvı defalarca damıtılarak yabancı"}, {"bas": 96.32, "son": 97.647, "metin": "atomlardan arındırılır."}, {"bas": 97.647, "son": 99.609, "metin": "Sonra çan şeklindeki reaktörlerde,"}, {"bas": 99.609, "son": 101.397, "metin": "yaklaşık bin yüz dereceye kadar"}, {"bas": 101.397, "son": 103.359, "metin": "ısıtılmış ince silisyum çubukların"}, {"bas": 103.359, "son": 104.513, "metin": "üzerinden geçirilir."}, {"bas": 104.513, "son": 106.705, "metin": "Saf silisyum çubukların üzerine katman"}, {"bas": 106.705, "son": 108.782, "metin": "katman çöker; çubuklar günler içinde"}, {"bas": 108.782, "son": 110.57, "metin": "kalınlaşır. Sonunda elde edilen"}, {"bas": 110.57, "son": 112.647, "metin": "polisilisyumda, milyon atomun içinde"}, {"bas": 112.647, "son": 114.321, "metin": "birden az yabancı atom kalır."}, {"bas": 114.321, "son": 116.571, "metin": "Bu çubuklar kırılarak parçalara ayrılır"}, {"bas": 116.571, "son": 118.417, "metin": "ve bir sonraki adıma gönderilir."}, {"bas": 119.117, "son": 120.303, "metin": "Şimdi sıra kristalde."}, {"bas": 120.303, "son": 122.392, "metin": "Polisilisyum parçaları, argon gazıyla"}, {"bas": 122.392, "son": 124.368, "metin": "doldurulmuş bir fırında, kuvars bir"}, {"bas": 124.368, "son": 126.513, "metin": "potada bin dört yüz derecenin üzerinde"}, {"bas": 126.513, "son": 128.715, "metin": "eritilir. Eriyiğe, hücrenin elektriksel"}, {"bas": 128.715, "son": 130.635, "metin": "karakterini belirleyecek çok küçük"}, {"bas": 130.635, "son": 132.555, "metin": "miktarda katkı maddesi de eklenir."}, {"bas": 132.555, "son": 134.813, "metin": "Ardından eriyiğe küçük bir tohum kristal"}, {"bas": 134.813, "son": 136.846, "metin": "dokundurulur. Tohum döndürülerek çok"}, {"bas": 136.846, "son": 138.031, "metin": "yavaş yukarı çekilir."}, {"bas": 138.031, "son": 140.064, "metin": "Önce ince bir boyun oluşturulur; bu,"}, {"bas": 140.064, "son": 141.927, "metin": "kristaldeki kusurların büyümesini"}, {"bas": 141.927, "son": 144.129, "metin": "engeller. Sonra çap genişler ve kütüğün"}, {"bas": 144.129, "son": 145.484, "metin": "gövdesi büyümeye başlar."}, {"bas": 145.484, "son": 147.404, "metin": "Silisyum atomları tohumun düzenini"}, {"bas": 147.404, "son": 148.59, "metin": "kopyalayarak dizilir."}, {"bas": 148.59, "son": 150.34, "metin": "Saatler sonra ortaya, tek parça"}, {"bas": 150.34, "son": 152.542, "metin": "kristalden oluşan, metrelerce uzunlukta"}, {"bas": 152.542, "son": 154.631, "metin": "bir kütük çıkar. Bu yöntemin adı, onu"}, {"bas": 154.631, "son": 156.833, "metin": "bulan Polonyalı bilim insanından gelir:"}, {"bas": 156.833, "son": 157.511, "metin": "Czochralski."}, {"bas": 158.211, "son": 160.468, "metin": "Yuvarlak kütük önce uçlarından kesilir,"}, {"bas": 160.468, "son": 162.61, "metin": "sonra kenarlarından dilimlenerek kare"}, {"bas": 162.61, "son": 164.404, "metin": "kesitli bir bloğa dönüştürülür."}, {"bas": 164.404, "son": 166.662, "metin": "Günümüzde en yaygın wafer boyutları yüz"}, {"bas": 166.662, "son": 168.861, "metin": "seksen iki ve iki yüz on milimetredir."}, {"bas": 168.861, "son": 171.003, "metin": "Ardından elmas taneleriyle kaplanmış,"}, {"bas": 171.003, "son": 173.087, "metin": "saç telinden bile ince çelik teller,"}, {"bas": 173.087, "son": 175.345, "metin": "bloğu aynı anda binlerce dilime ayırır."}, {"bas": 175.345, "son": 177.428, "metin": "Her dilim, yani wafer, yaklaşık 0,15"}, {"bas": 177.428, "son": 179.628, "metin": "milimetre kalınlığındadır; parmakların"}, {"bas": 179.628, "son": 181.77, "metin": "arasında esneyebilecek kadar incedir."}, {"bas": 181.77, "son": 183.796, "metin": "Bu kesimde silisyumun bir kısmı toz"}, {"bas": 183.796, "son": 185.938, "metin": "olarak kaybolur. Bu yüzden üreticiler"}, {"bas": 185.938, "son": 188.195, "metin": "daha ince teller ve daha ince wafer'lar"}, {"bas": 188.195, "son": 189.411, "metin": "için sürekli yarışır."}, {"bas": 190.111, "son": 192.407, "metin": "Wafer'ın hücreye dönüşmesi birkaç hassas"}, {"bas": 192.407, "son": 194.704, "metin": "adımda olur. Önce kesimden kalan hasarlı"}, {"bas": 194.704, "son": 196.771, "metin": "yüzey kimyasalla temizlenir ve yüzey"}, {"bas": 196.771, "son": 198.952, "metin": "pürüzlendirilir. Bu işlem, mikroskobik"}, {"bas": 198.952, "son": 200.617, "metin": "piramitler oluşturur; ışık bu"}, {"bas": 200.617, "son": 202.741, "metin": "piramitlerin arasında sekerek içeride"}, {"bas": 202.741, "son": 204.808, "metin": "kalır. Sonra yüksek sıcaklıkta katkı"}, {"bas": 204.808, "son": 206.76, "metin": "atomları yüzeye yayılır ve bir p-n"}, {"bas": 206.76, "son": 207.851, "metin": "eklemi oluşturulur."}, {"bas": 207.851, "son": 209.975, "metin": "Elektriği üreten asıl yapı budur: İki"}, {"bas": 209.975, "son": 212.042, "metin": "farklı katmanın sınırında kalıcı bir"}, {"bas": 212.042, "son": 213.248, "metin": "elektrik alanı doğar."}, {"bas": 213.248, "son": 215.257, "metin": "Üzerine silisyum nitrürden ince bir"}, {"bas": 215.257, "son": 217.152, "metin": "yansıma önleyici kaplama serilir."}, {"bas": 217.152, "son": 219.391, "metin": "Hücreye o koyu mavi rengini veren de bu"}, {"bas": 219.391, "son": 221.573, "metin": "katmandır. Son olarak gümüş macun ince"}, {"bas": 221.573, "son": 223.812, "metin": "çizgiler hâlinde basılır ve fırınlanır."}, {"bas": 223.812, "son": 226.108, "metin": "Bu çizgiler, üretilen elektriği toplayan"}, {"bas": 226.108, "son": 228.003, "metin": "yollardır. Her hücre ışık altında"}, {"bas": 228.003, "son": 229.381, "metin": "ölçülür ve verimine göre"}, {"bas": 229.381, "son": 231.448, "metin": "sınıflandırılır. Bugünün seri üretim"}, {"bas": 231.448, "son": 233.17, "metin": "hücreleri, üzerine düşen güneş"}, {"bas": 233.17, "son": 235.122, "metin": "enerjisinin yaklaşık dörtte birini"}, {"bas": 235.122, "son": 236.5, "metin": "elektriğe çevirebiliyor."}, {"bas": 237.2, "son": 239.667, "metin": "Panel montaj hattında hücreler önce çoğu"}, {"bas": 239.667, "son": 241.825, "metin": "zaman ikiye kesilir; yarım hücreler"}, {"bas": 241.825, "son": 243.983, "metin": "kayıpları azaltır. Sonra ince bakır"}, {"bas": 243.983, "son": 246.018, "metin": "şeritlerle birbirine lehimlenerek"}, {"bas": 246.018, "son": 247.252, "metin": "diziler oluşturulur."}, {"bas": 247.252, "son": 249.348, "metin": "Diziler, temperli cam ile koruyucu"}, {"bas": 249.348, "son": 251.692, "metin": "folyolar arasına yerleştirilir, arkası"}, {"bas": 251.692, "son": 254.035, "metin": "dayanıklı bir arka katmanla kapatılır."}, {"bas": 254.035, "son": 255.823, "metin": "Lamine edilmeden önce panelin"}, {"bas": 255.823, "son": 258.228, "metin": "elektrolüminesans fotoğrafı çekilir; bu"}, {"bas": 258.228, "son": 260.202, "metin": "görüntüde gözle görülmeyen mikro"}, {"bas": 260.202, "son": 261.928, "metin": "çatlaklar bile ortaya çıkar."}, {"bas": 261.928, "son": 264.333, "metin": "Ardından laminatörde ısı ve vakumla tüm"}, {"bas": 264.333, "son": 266.615, "metin": "katmanlar tek parça hâline getirilir."}, {"bas": 266.615, "son": 269.082, "metin": "Alüminyum çerçeve takılır, arkaya baypas"}, {"bas": 269.082, "son": 271.055, "metin": "diyotlu bağlantı kutusu eklenir."}, {"bas": 271.055, "son": 273.213, "metin": "Son olarak her panel, saniyenin bir"}, {"bas": 273.213, "son": 275.372, "metin": "kısmı kadar süren yapay güneş flaşı"}, {"bas": 275.372, "son": 277.715, "metin": "altında test edilir ve gücünü gösteren"}, {"bas": 277.715, "son": 278.64, "metin": "etiketini alır."}, {"bas": 279.34, "son": 281.513, "metin": "Bitmiş paneller paletlere dizilir, köşe"}, {"bas": 281.513, "son": 283.574, "metin": "korumaları takılır ve sıkıca sarılır."}, {"bas": 283.574, "son": 285.635, "metin": "Bir palette genellikle otuz civarında"}, {"bas": 285.635, "son": 287.306, "metin": "panel bulunur. Kırk fitlik bir"}, {"bas": 287.306, "son": 289.479, "metin": "konteynere altı yüzü aşkın panel sığar."}, {"bas": 289.479, "son": 291.595, "metin": "Konteynerler limana taşınır, gemilerle"}, {"bas": 291.595, "son": 293.434, "metin": "okyanusları aşar. Varış limanında"}, {"bas": 293.434, "son": 295.439, "metin": "gümrükten geçer, tırlara yüklenir ve"}, {"bas": 295.439, "son": 297.333, "metin": "santral sahasına doğru yola çıkar."}, {"bas": 297.333, "son": 299.506, "metin": "Sahaya gelen her palet sayılır, kontrol"}, {"bas": 299.506, "son": 301.678, "metin": "edilir ve hasarlı panel olup olmadığına"}, {"bas": 301.678, "son": 302.124, "metin": "bakılır."}, {"bas": 302.824, "son": 305.05, "metin": "Sahada iş, panellerden çok önce başlar."}, {"bas": 305.05, "son": 307.219, "metin": "Önce zemin etüdü yapılır ve kazıkların"}, {"bas": 307.219, "son": 309.387, "metin": "ne kadar derine çakılacağı hesaplanır."}, {"bas": 309.387, "son": 311.099, "metin": "Ardından çelik kazıklar, çakma"}, {"bas": 311.099, "son": 313.154, "metin": "makineleriyle düzgün sıralar hâlinde"}, {"bas": 313.154, "son": 315.151, "metin": "toprağa çakılır. Kazıkların üzerine"}, {"bas": 315.151, "son": 316.407, "metin": "konstrüksiyon kurulur."}, {"bas": 316.407, "son": 318.633, "metin": "Bazı sistemler sabit açılıdır; bazıları"}, {"bas": 318.633, "son": 320.687, "metin": "ise tracker denilen, güneşi gün boyu"}, {"bas": 320.687, "son": 322.742, "metin": "takip eden tek eksenli sistemlerdir."}, {"bas": 322.742, "son": 324.967, "metin": "Paneller tek tek taşınır, yerleştirilir"}, {"bas": 324.967, "son": 326.508, "metin": "ve kelepçelerle sabitlenir."}, {"bas": 326.508, "son": 328.791, "metin": "Ardından kablolama başlar: Paneller seri"}, {"bas": 328.791, "son": 331.017, "metin": "bağlanarak diziler oluşturulur, diziler"}, {"bas": 331.017, "son": 332.786, "metin": "invertörlere, invertörler trafo"}, {"bas": 332.786, "son": 333.87, "metin": "merkezine bağlanır."}, {"bas": 333.87, "son": 335.982, "metin": "Son olarak bütün sistem ölçülür, test"}, {"bas": 335.982, "son": 338.265, "metin": "edilir ve şebekeye bağlantı için devreye"}, {"bas": 338.265, "son": 338.664, "metin": "alınır."}, {"bas": 339.364, "son": 340.703, "metin": "Ve sonunda güneş doğar."}, {"bas": 340.703, "son": 342.914, "metin": "Işıktaki fotonlar hücreye çarptığında,"}, {"bas": 342.914, "son": 344.893, "metin": "silisyumdaki elektronları yerinden"}, {"bas": 344.893, "son": 347.221, "metin": "koparır. p-n ekleminin elektrik alanı bu"}, {"bas": 347.221, "son": 349.141, "metin": "elektronları tek yöne iter; gümüş"}, {"bas": 349.141, "son": 351.237, "metin": "çizgiler onları toplar ve doğru akım"}, {"bas": 351.237, "son": 353.565, "metin": "doğar. Paneller seri bağlandıkça gerilim"}, {"bas": 353.565, "son": 355.543, "metin": "yükselir. İnvertör, panellerden en"}, {"bas": 355.543, "son": 357.697, "metin": "yüksek gücü çekecek çalışma noktasını"}, {"bas": 357.697, "son": 359.908, "metin": "sürekli arar ve doğru akımı, şebekenin"}, {"bas": 359.908, "son": 362.003, "metin": "kullandığı alternatif akıma çevirir."}, {"bas": 362.003, "son": 364.157, "metin": "Trafo gerilimi yükseltir ve elektrik,"}, {"bas": 364.157, "son": 366.368, "metin": "iletim hatlarıyla evlere, fabrikalara,"}, {"bas": 366.368, "son": 368.23, "metin": "şehirlere akar. Bir santralde bu"}, {"bas": 368.23, "son": 370.442, "metin": "dönüşüm, hiç durmadan, gün boyu sürer."}, {"bas": 371.142, "son": 373.493, "metin": "Bir güneş paneli, yirmi beş ila otuz yıl"}, {"bas": 373.493, "son": 375.727, "metin": "boyunca hiçbir yakıt yakmadan elektrik"}, {"bas": 375.727, "son": 377.961, "metin": "üretir. Pek çok üretici, yirmi beş yıl"}, {"bas": 377.961, "son": 380.313, "metin": "sonra bile panelin gücünün büyük kısmını"}, {"bas": 380.313, "son": 381.841, "metin": "koruyacağını garanti eder."}, {"bas": 381.841, "son": 384.193, "metin": "Güneşli bölgelerde bir panel, üretiminde"}, {"bas": 384.193, "son": 386.544, "metin": "harcanan enerjiyi birkaç yıl içinde geri"}, {"bas": 386.544, "son": 388.484, "metin": "kazanır. Ömrünün sonunda camının,"}, {"bas": 388.484, "son": 390.542, "metin": "alüminyumunun ve silisyumunun büyük"}, {"bas": 390.542, "son": 392.188, "metin": "kısmı geri dönüştürülebilir."}, {"bas": 392.188, "son": 394.128, "metin": "Bir avuç kumla başlayan yolculuk,"}, {"bas": 394.128, "son": 396.068, "metin": "şehirleri aydınlatan bir enerjiye"}, {"bas": 396.068, "son": 398.008, "metin": "dönüşür. Enerji Üretim Kaynakları"}, {"bas": 398.008, "son": 400.359, "metin": "serisinin devamı için Kozmos Lab'i takip"}, {"bas": 400.359, "son": 401.182, "metin": "etmeyi unutma!"}], "gecis": "kara", "toplam": 404.382, "dil": "tr"}