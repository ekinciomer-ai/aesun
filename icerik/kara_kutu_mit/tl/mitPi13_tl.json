{"kaza": 5.692245000000001, "poll": 21.728707000000004, "cd0": 27.067213900000006, "rew": 31.503265000000006, "rewDur": 0.8, "slow": 32.303265, "karar": 42.214307999999996, "ders": 52.19652999999999, "next": 54.84774419999999, "end": 58.82700599999998, "suc": 999, "cut": 999, "_imp": 16.764253453333335, "map": [[5.692245000000001, 1.7999999999999998], [13.144195000000002, 4.0], [16.764253453333335, 6.0], [21.728707000000004, 7.4]], "rwTo": 3.4, "slowRate": 0.24215413049867726, "clues": [[33.13912975144509, "İşveren: gece mesaj attı"], [37.68591867052023, "Mesajlar inceleniyor"], [39.36991456647399, "Hakaret YOK"]], "reasons": [[43.24253019999999, "İspat yükü işverende"], [45.60177197647058, "Hakaret ispatlanamadı"]], "hukum": 47.730843823529405, "onay": 50.34652999999999, "caps": [[0.25, 2.24, "Kod 29la çıkarıldıysan,"], [2.24, 4.23, "iş biter. Genelde<br>böyle bilinir."], [4.23, 5.54, "Peki mahkeme ne dedi?"], [5.74, 8.11, "Bir fabrikada kimya<br>teknikeri işe başlıyor."], [8.11, 9.49, "Dördüncü gün<br>fark ediyor:"], [9.49, 11.8, "Sigorta kaydına paketleme<br>işçisi yazılmış."], [11.8, 13.06, "Düzeltilmesini istiyor."], [13.14, 15.06, "Aynı akşam muhasebeye<br>çağrılıyor."], [15.06, 16.75, "Önce istifa<br>etmesi isteniyor."], [16.75, 17.68, "Kabul etmeyince,"], [17.68, 18.72, "kod 29la,"], [18.72, 21.63, "yani ahlak ve iyi niyete<br>aykırılıktan çıkarılıyor."], [21.83, 24.55, "Sizce teknikerin<br>kodu düzeltildi mi?"], [24.55, 26.44, "A, hayır, kod<br>kesinleşti."], [26.44, 28.25, "B, sadece tazminat aldı."], [28.25, 29.84, "C, evet, kod değişti."], [29.84, 31.35, "Cevabını yoruma yaz."], [32.35, 34.13, "Geri saralım.<br>İşveren diyor ki:"], [34.13, 35.92, "Herkes hakkında<br>dedikodu yaptı,"], [35.92, 37.64, "gece arkadaşlarına<br>mesaj attı."], [37.64, 39.31, "Mesajlar mahkemeye<br>sunuluyor."], [39.31, 42.06, "Saatleri geç, ama içlerinde<br>tek bir hakaret yok."], [42.26, 43.21, "Mahkeme dedi ki:"], [43.21, 45.56, "Haklı sebebi ispat<br>etmek işverene düşer."], [45.56, 46.86, "Hakaret ispatlanamadı,"], [46.86, 51.16, "fesih haksız. Kod 29 silinip<br>kod 04 olarak düzeltilecek."], [51.16, 52.05, "Yargıtay onadı."], [52.25, 54.02, "Kod 29 son söz değil."], [54.02, 56.67, "İşveren ispat edemezse<br>mahkeme kodu düzeltir."], [56.67, 58.03, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.7422450000000005, 13.144195000000002, 21.828707000000005, 32.353265, 42.26430799999999, 52.246529999999986]}