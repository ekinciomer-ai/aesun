{"sahneler": [{"ad": "s0", "bas": 0, "son": 5.420063}, {"ad": "s1", "bas": 5.420063, "son": 11.123396}, {"ad": "s2", "bas": 11.123396, "son": 17.252313}, {"ad": "s3", "bas": 17.252313, "son": 25.163584000000004}, {"ad": "s4", "bas": 25.163584000000004, "son": 31.736730000000005}], "altyazi": [{"bas": 0.4, "son": 2.331, "metin": "Binlerce güneş paneli arasında bozuk"}, {"bas": 2.331, "son": 3.457, "metin": "olanı nasıl bulursun?"}, {"bas": 3.457, "son": 5.12, "metin": "Tek tek gezerek değil, havadan!"}, {"bas": 5.42, "son": 7.547, "metin": "Bu drone'un altında iki göz var: biri"}, {"bas": 7.547, "son": 9.214, "metin": "normal kamera, diğeri termal."}, {"bas": 9.214, "son": 10.823, "metin": "Termal kamera ısıyı görüyor."}, {"bas": 11.123, "son": 13.161, "metin": "Arızalı bir hücre daha fazla ısınır."}, {"bas": 13.161, "son": 15.141, "metin": "Ekranda, sağlam panellerin arasında"}, {"bas": 15.141, "son": 16.952, "metin": "parlayan bir nokta gibi belirir."}, {"bas": 17.252, "son": 19.59, "metin": "Otuz metre yükseklikte termal kameranın"}, {"bas": 19.59, "son": 21.507, "metin": "her pikseli, yerde yaklaşık dört"}, {"bas": 21.507, "son": 22.766, "metin": "santimetreyi görüyor."}, {"bas": 22.766, "son": 24.864, "metin": "Tek bir hücre bile gözden kaçmıyor."}, {"bas": 25.164, "son": 27.34, "metin": "Peki kırk kiloluk bir yükü havadan"}, {"bas": 27.34, "son": 29.837, "metin": "teslim etmek? O da bir sonraki videoda!"}], "gecis": "flas", "toplam": 31.737, "dil": "tr"}