{"toplam": 59.62, "dil": "tr", "parca": {"V1": [0.35, 5.66], "V2": [5.66, 15.45], "V3": [15.45, 19.24], "V4": [19.24, 30.163], "V5": [30.163, 40.549], "V6": [40.549, 51.783], "V7": [51.783, 59.62]}, "sayac": [27.563, 30.063], "altyazi": [{"bas": 0.35, "son": 2.142, "metin": "Yaya geçidi dışından geçen yayaya"}, {"bas": 2.142, "son": 3.337, "metin": "çarparsan kusursuzsun."}, {"bas": 3.337, "son": 4.369, "metin": "Herkes böyle bilir."}, {"bas": 4.369, "son": 5.51, "metin": "Peki mahkeme ne dedi?"}, {"bas": 5.66, "son": 7.902, "metin": "Sabah, şehir içinde tek yönlü bir cadde."}, {"bas": 7.902, "son": 9.92, "metin": "Hız sınırı elli. Bir otomobil trafik"}, {"bas": 9.92, "son": 10.985, "metin": "ışıklarını geçiyor."}, {"bas": 10.985, "son": 12.89, "metin": "Yirmi metre ileride bir yaya, orta"}, {"bas": 12.89, "son": 14.067, "metin": "refüjden yola iniyor."}, {"bas": 14.067, "son": 15.3, "metin": "Orada yaya geçidi yok."}, {"bas": 15.45, "son": 17.711, "metin": "Otomobil yavaşlamıyor ve yayaya çarpıyor."}, {"bas": 17.711, "son": 19.09, "metin": "Yaya hayatını kaybediyor."}, {"bas": 19.24, "son": 21.054, "metin": "Sence sürücüye ne oldu?"}, {"bas": 21.054, "son": 22.631, "metin": "A, kusursuz, beraat."}, {"bas": 22.631, "son": 24.524, "metin": "B, tali kusurlu, mahkûm."}, {"bas": 24.524, "son": 27.363, "metin": "C, tam kusurlu. Cevabını yoruma yaz."}, {"bas": 30.163, "son": 31.782, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 31.782, "son": 33.98, "metin": "yaya, geçit olmayan yerden yola girdi."}, {"bas": 33.98, "son": 36.235, "metin": "İkinci ipucu: yolda hiç fren izi yoktu."}, {"bas": 36.235, "son": 38.548, "metin": "Üçüncü ipucu: sürücünün avukatı, kusurun"}, {"bas": 38.548, "son": 40.399, "metin": "tamamen yayada olduğunu savundu."}, {"bas": 40.549, "son": 42.72, "metin": "Mahkeme dedi ki: yaya kurala uymasa da"}, {"bas": 42.72, "son": 44.263, "metin": "sürücü de dikkatli değildi."}, {"bas": 44.263, "son": 45.405, "metin": "Sürücü tali kusurlu."}, {"bas": 45.405, "son": 47.234, "metin": "Taksirle öldürmeden mahkûm oldu."}, {"bas": 47.234, "son": 49.576, "metin": "Hapis cezası adli para cezasına çevrildi,"}, {"bas": 49.576, "son": 50.776, "metin": "ehliyeti geri alındı."}, {"bas": 50.776, "son": 51.633, "metin": "Yargıtay onadı."}, {"bas": 51.783, "son": 53.598, "metin": "Yani yaya hata yapsa bile sürücü"}, {"bas": 53.598, "son": 54.96, "metin": "sorumluluktan kurtulmaz."}, {"bas": 54.96, "son": 57.115, "metin": "Yolu hep izle, yayayı görünce yavaşla."}, {"bas": 57.115, "son": 58.42, "metin": "Sen hangi şıkkı seçtin?"}], "carp": 16.959, "tali": 44.262, "onayT": 50.802, "ip": [30.954, 34.008, 36.327]}