{"kaza": 5.872041, "poll": 18.379592000000002, "cd0": 23.087245050000003, "rew": 27.007143000000003, "rewDur": 0.8, "slow": 27.807143000000003, "karar": 37.286485000000006, "ders": 51.902018000000005, "next": 54.820058800000005, "end": 59.125442, "suc": 999, "cut": 999, "_imp": 16.760250567164178, "map": [[5.872041, 1.7999999999999998], [11.008458, 4.0], [16.760250567164178, 6.0], [18.379592000000002, 7.4]], "rwTo": 3.4, "slowRate": 0.25318213015207164, "clues": [[28.679363177215194, "Dilekçe işe giriş günü imzalatılmış"], [32.79046406329114, "İlk mahkeme: tazminat yok"], [35.55077465822785, "Dosya istinafa gidiyor"]], "reasons": [[38.887159864541836, "Giriş günü istifa = zor durumdan yararlanma"], [45.31958893227092, "Kıdem + ihbar tazminatı ödenecek"]], "hukum": 47.67431743027889, "onay": 50.052018000000004, "caps": [[0.25, 2.11, "İstifa dilekçesini<br>imzaladıysan,"], [2.11, 3.22, "tazminat alamazsın."], [3.22, 4.5, "Genelde böyle bilinir."], [4.5, 5.72, "Peki mahkeme ne dedi?"], [5.92, 7.74, "Bir tır şoförü yeni işe<br>giriyor."], [7.74, 9.45, "Önüne bir yığın evrak<br>konuyor."], [9.45, 10.93, "Hepsini tek tek<br>imzalıyor."], [11.01, 12.78, "5 yıl sonra işten<br>çıkarılıyor."], [12.78, 14.84, "İşveren dosyadan bir<br>kâğıt çıkarıyor:"], [14.84, 16.73, "Kendi isteğimle<br>ayrılıyorum yazan,"], [16.73, 18.28, "imzalı bir istifa<br>dilekçesi."], [18.48, 20.92, "Sizce şoför tazminatını<br>aldı mı?"], [20.92, 22.44, "A, hayır, imza onun."], [22.44, 23.73, "B, evet, aldı. C,"], [23.73, 25.33, "sadece yarısını aldı."], [25.33, 26.86, "Cevabını yoruma yaz."], [27.86, 29.3, "Geri saralım. O dilekçe,"], [29.3, 30.27, "işe girdiği gün,"], [30.27, 32.74, "giriş evraklarının<br>arasında imzalatılmış."], [32.74, 35.51, "İlk mahkeme imzaya bakıp<br>tazminatı reddediyor."], [35.51, 37.14, "Ama dosya istinafa<br>gidiyor."], [37.34, 38.87, "İstinaf mahkemesi dedi<br>ki:"], [38.87, 41.57, "İş arayan birine giriş<br>günü istifa imzalatmak,"], [41.57, 43.63, "onun zor durumundan<br>yararlanmaktır."], [43.63, 45.28, "Bu dilekçeye itibar<br>edilmez."], [45.28, 47.63, "Şoför kıdem ve ihbar<br>tazminatını alacak."], [47.63, 49.73, "İzin defteri<br>sunulamadığı için izin"], [49.73, 50.87, "ücretini de alacak."], [50.87, 51.75, "Yargıtay onadı."], [51.95, 54.36, "Mahkemeye göre, işe<br>girerken imzalatılan"], [54.36, 56.96, "istifa dilekçesi seni<br>tazminatsız bırakmaz."], [56.96, 58.33, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 5.922041, 11.008458, 18.479592000000004, 27.857143000000004, 37.336485, 51.952018]}