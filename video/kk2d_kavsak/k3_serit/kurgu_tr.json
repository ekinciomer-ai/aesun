{"toplam": 59.179, "dil": "tr", "parca": {"V1": [0.35, 5.743], "V2": [5.743, 14.754], "V3": [14.754, 20.657], "V4": [20.657, 32.646], "V5": [32.646, 41.659], "V6": [41.659, 51.754], "V7": [51.754, 59.179]}, "sayac": [30.046, 32.546], "altyazi": [{"bas": 0.35, "son": 2.33, "metin": "Yolda duran araca arkadan çarpan, her"}, {"bas": 2.33, "son": 3.453, "metin": "zaman tam kusurludur."}, {"bas": 3.453, "son": 4.47, "metin": "Herkes böyle bilir."}, {"bas": 4.47, "son": 5.593, "metin": "Peki mahkeme ne dedi?"}, {"bas": 5.743, "son": 7.626, "metin": "Gece, şehir dışı, ışıksız bir yol."}, {"bas": 7.626, "son": 9.73, "metin": "Bir otomobilin elektriği arızalanıyor."}, {"bas": 9.73, "son": 11.613, "metin": "Sürücü aracı yol kenarına çekiyor."}, {"bas": 11.613, "son": 13.828, "metin": "Ama emniyet şeridi dar, aracın bir kısmı"}, {"bas": 13.828, "son": 14.604, "metin": "yolda kalıyor."}, {"bas": 14.754, "son": 16.653, "metin": "Arkadan, yolcusuyla bir motosiklet"}, {"bas": 16.653, "son": 18.775, "metin": "geliyor. Duran araca arkadan çarpıyor."}, {"bas": 18.775, "son": 20.507, "metin": "Sürücü de yolcu da yaralanıyor."}, {"bas": 20.657, "son": 23.116, "metin": "Sence duran aracın sürücüsüne ne oldu?"}, {"bas": 23.116, "son": 25.251, "metin": "A, hiçbir şey, o park halindeydi."}, {"bas": 25.251, "son": 26.805, "metin": "B, sadece trafik cezası."}, {"bas": 26.805, "son": 28.552, "metin": "C, yaralamadan mahkûm oldu."}, {"bas": 28.552, "son": 29.846, "metin": "Cevabını yoruma yaz."}, {"bas": 32.646, "son": 34.289, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 34.289, "son": 35.992, "metin": "araç yolu kısmen kapatıyordu."}, {"bas": 35.992, "son": 38.163, "metin": "İkinci ipucu: gece ve yol karanlıktı."}, {"bas": 38.163, "son": 40.394, "metin": "Üçüncü ipucu: sürücü yola hiçbir uyarı"}, {"bas": 40.394, "son": 41.509, "metin": "işareti koymamıştı."}, {"bas": 41.659, "son": 43.391, "metin": "Duran aracın sürücüsü, taksirle"}, {"bas": 43.391, "son": 44.732, "metin": "yaralamadan mahkûm oldu."}, {"bas": 44.732, "son": 47.023, "metin": "Hapis cezası adli para cezasına çevrildi."}, {"bas": 47.023, "son": 49.202, "metin": "Yargıtay onadı. Hatta Yargıtay dedi ki:"}, {"bas": 49.202, "son": 50.878, "metin": "bu sürücü aslında asli kusurlu"}, {"bas": 50.878, "son": 51.604, "metin": "sayılmalıydı."}, {"bas": 51.754, "son": 53.753, "metin": "Yani arıza yaptıysan durman yetmez."}, {"bas": 53.753, "son": 55.866, "metin": "Dörtlüleri yak, reflektörü koy, aracı"}, {"bas": 55.866, "son": 57.979, "metin": "yoldan çıkar. Sen hangi şıkkı seçtin?"}], "carp": 17.971999999999998, "tali": 47.909, "onayT": 47.039, "ip": [33.447, 36.02, 38.25]}