{"kaza": 6.665850000000001, "poll": 23.709591000000003, "cd0": 28.157297550000003, "rew": 31.864512000000005, "rewDur": 0.8, "slow": 32.664512, "karar": 42.531315, "ders": 52.637232999999995, "next": 55.832610599999995, "end": 60.47696099999999, "suc": 999, "cut": 999, "_imp": 18.045401824561402, "map": [[6.665850000000001, 1.7999999999999998], [15.037732, 4.0], [18.045401824561402, 6.0], [23.709591000000003, 7.4]], "rwTo": 3.4, "slowRate": 0.24323988225973506, "clues": [[33.555103565217394, "İş birliği ispatlanamadı"], [37.037554335403726, "Tanıklar görmedi"], [38.59865295652174, "Avukat ağabeyiyle konuşmuş"]], "reasons": [[43.49653568478261, "Her belgede imza, itiraz notu yok"], [46.888235869565214, "Baskı ispatlanamadı"]], "hukum": 49.41855188043478, "onay": 50.78723299999999, "caps": [[0.25, 2.28, "Arabulucuda<br>imzaladığın anlaşmayı,"], [2.28, 3.95, "sonra mahkemede<br>bozdurursun."], [3.95, 5.26, "Genelde böyle bilinir."], [5.26, 6.52, "Peki mahkeme ne dedi?"], [6.72, 7.87, "Bir makine mühendisi,"], [7.87, 10.45, "aynı şirkette çalışan<br>bir mühendisle evleniyor."], [10.45, 12.27, "10 gün sonra eşi<br>işten ayrılıyor."], [12.27, 14.96, "Ertesi gün ona da işine<br>son verildiği söyleniyor."], [15.04, 16.79, "Arabulucuda bir<br>anlaşma imzalıyor."], [16.79, 18.03, "Sonra mahkemeye gidiyor:"], [18.03, 19.17, "Baskıyla imzalattılar,"], [19.17, 20.72, "hakkım iki<br>yüz 20.000 TL,"], [20.72, 22.47, "bana 141.593 TL ödendi."], [22.47, 23.61, "Anlaşma iptal edilsin."], [23.81, 25.66, "Sizce anlaşma<br>bozuldu mu?"], [25.66, 27.06, "A, evet, baskı var."], [27.06, 28.98, "B, hayır,<br>anlaşma geçerli."], [28.98, 30.24, "C, fark ödenecek."], [30.24, 31.71, "Cevabını yoruma yaz."], [32.71, 37.03, "Geri saralım. Arabulucunun işverenle<br>iş birliği yaptığı ispatlanamıyor."], [37.03, 38.55, "Tanıklar o<br>odada değildi."], [38.55, 42.38, "Üstelik görüşme sırasında avukat<br>ağabeyiyle telefonda konuşmuş."], [42.58, 43.47, "Mahkeme dedi ki:"], [43.47, 45.03, "Bütün belgelerde<br>imzası var,"], [45.03, 46.87, "hiçbirine itiraz<br>notu düşülmemiş."], [46.87, 49.43, "Baskı da aşırı dengesizlik<br>de ispat edilemedi."], [49.43, 50.32, "Anlaşma geçerli,"], [50.32, 51.65, "iptal talebi reddedildi."], [51.65, 52.49, "Yargıtay onadı."], [52.69, 55.54, "Arabulucuda attığın imza<br>sonradan kolay bozulmaz."], [55.54, 56.76, "Rakamı beğenmiyorsan,"], [56.76, 58.34, "imzalamadan<br>önce itiraz et."], [58.34, 59.68, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.7158500000000005, 15.037732, 23.809591000000005, 32.714512, 42.581315, 52.68723299999999]}