creti son ücret"], [44.0, 45.04, "üzerinden ödenir."], [45.04, 47.55, "İzni kullandırdığını<br>ispat etmek işverene"], [47.55, 47.92, "düşer."], [47.92, 51.4, "8.943 TL izin ücretine<br>hükmedildi."], [51.4, 52.3, "Yargıtay onadı."], [52.5, 54.06, "Kullanmadığın izin<br>yanmaz,"], [54.06, 55.62, "iş bitince paraya<br>dönüşür."], [55.62, 58.01, "İzin kullandığında<br>mutlaka imzalı kayıt"], [58.01, 58.38, "olsun."], [58.38, 59.76, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.43288, 12.14025, 17.115919, 26.43991, 38.436462999999996, 52.50430899999999]}