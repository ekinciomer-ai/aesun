{"toplam": 49.384, "dil": "tr", "parca": {"V1": [0.35, 6.304], "V2": [6.304, 11.452], "V3": [11.452, 14.601], "V4": [14.601, 24.483], "V5": [24.483, 35.103], "V6": [35.103, 42.704], "V7": [42.704, 49.384]}, "sayac": [21.883, 24.383], "altyazi": [{"bas": 0.35, "son": 1.557, "metin": "Yol buzluydu, kaydın."}, {"bas": 1.557, "son": 2.649, "metin": "Tuzlama yapılmamış."}, {"bas": 2.649, "son": 3.856, "metin": "Faturayı devlet öder."}, {"bas": 3.856, "son": 4.947, "metin": "Herkes böyle bilir."}, {"bas": 4.947, "son": 6.154, "metin": "Peki mahkeme ne dedi?"}, {"bas": 6.304, "son": 7.732, "metin": "Kış günü, karlı bir yol."}, {"bas": 7.732, "son": 9.101, "metin": "Bir otomobil ilerliyor."}, {"bas": 9.101, "son": 11.302, "metin": "Zemin buz tutmuş, tuzlama yapılmamış."}, {"bas": 11.452, "son": 13.188, "metin": "Otomobil kayıyor, yoldan çıkıyor."}, {"bas": 13.188, "son": 14.451, "metin": "Araç ağır hasar görüyor."}, {"bas": 14.601, "son": 16.167, "metin": "Sence hasarı kim ödedi?"}, {"bas": 16.167, "son": 18.891, "metin": "A, devlet ödedi. B, yarı yarıya bölündü."}, {"bas": 18.891, "son": 20.321, "metin": "C, idare hiç ödemedi."}, {"bas": 20.321, "son": 21.683, "metin": "Cevabını yoruma yaz."}, {"bas": 24.483, "son": 26.043, "metin": "Geri saralım. Birinci ipucu:"}, {"bas": 26.043, "son": 27.658, "metin": "zemin gerçekten buz tutmuştu."}, {"bas": 27.658, "son": 29.829, "metin": "İkinci ipucu: hasarı kasko ödedi, sonra"}, {"bas": 29.829, "son": 31.11, "metin": "parayı idareden istedi."}, {"bas": 31.11, "son": 32.948, "metin": "Üçüncü ipucu: mahkeme, bir teknik"}, {"bas": 32.948, "son": 34.953, "metin": "üniversiteden bilirkişi raporu aldı."}, {"bas": 35.103, "son": 36.063, "metin": "Bilirkişi raporu:"}, {"bas": 36.063, "son": 37.869, "metin": "kazada sürücü yüzde yüz kusurlu."}, {"bas": 37.869, "son": 39.393, "metin": "İdarenin hizmet kusuru yok."}, {"bas": 39.393, "son": 41.708, "metin": "Yirmi bin yirmi liralık talep reddedildi."}, {"bas": 41.708, "son": 42.554, "metin": "Danıştay onadı."}, {"bas": 42.704, "son": 44.74, "metin": "Yani buzlu yol tek başına bahane değil."}, {"bas": 44.74, "son": 46.775, "metin": "Kışın hızını yola göre ayarla, mesafeni"}, {"bas": 46.775, "son": 48.184, "metin": "aç. Sen hangi şıkkı seçtin?"}], "carp": 12.533, "tali": 37.897, "onayT": 41.787, "ip": [25.243, 27.684, 31.21]}