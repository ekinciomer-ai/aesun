, 50.44, "Yargıtay onadı."], [50.64, 52.97, "Sendikaya üye olduğun<br>için çıkarılamazsın."], [52.97, 54.25, "Bahane ne olursa olsun,"], [54.25, 55.81, "işveren ispat<br>etmek zorunda."], [55.81, 57.09, "Sen hangi şıkkı seçtin?"]], "_starts": [0.25, 6.404966, 12.643946, 19.423833000000002, 28.805602, 40.070659, 50.637212]}