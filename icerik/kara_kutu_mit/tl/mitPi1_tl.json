{"kaza": 7.249796, "poll": 22.528073, "cd0": 24.028073, "rew": 34.711678, "rewDur": 1.3, "slow": 36.011677999999996, "karar": 47.748503, "ders": 65.27564600000001, "next": 68.86296250000001, "end": 74.20301600000002, "suc": 999, "cut": 999, "_imp": 20.505556970149254, "map": [[7.249796, 1.7999999999999998], [13.606031999999999, 4.0], [20.505556970149254, 6.0], [22.528073, 7.4]], "rwTo": 3.4, "slowRate": 0.2044846029484123, "clues": [[37.20734603797468, "Dilekçe işe giriş günü imzalatılmış"], [42.1856862278481, "İlk mahkeme: tazminat yok"], [45.52828606962025, "Dosya istinafa gidiyor"]], "reasons": [[49.76935105179283, "Giriş günü istifa = zor durumdan yararlanma"], [57.322498525896414, "Kıdem + ihbar tazminatı ödenecek"]], "hukum": 60.0874900119522, "onay": 63.175646, "caps": [[0.3, 2.57, "İstifa dilekçesini<br>imzaladıysan,"], [2.57, 3.91, "tazminat alamazsın."], [3.91, 5.26, "Herkes böyle bilir."], [5.26, 6.75, "Peki mahkeme ne dedi?"], [7.45, 9.6, "Bir tır şoförü yeni işe<br>giriyor."], [9.6, 11.61, "Önüne bir yığın evrak<br>konuyor."], [11.61, 13.36, "Hepsini tek tek<br>imzalıyor."], [13.61, 15.74, "Beş yıl sonra işten<br>çıkarılıyor."], [15.74, 18.2, "İşveren dosyadan bir<br>kâğıt çıkarıyor:"], [18.2, 20.46, "Kendi isteğimle<br>ayrılıyorum yazan,"], [20.46, 22.33, "imzalı bir istifa<br>dilekçesi."], [22.73, 26.11, "Sizce şoför tazminatını<br>aldı mı?"], [26.11, 28.23, "A, hayır, imza onun."], [28.23, 30.03, "B, evet, aldı. C,"], [30.03, 32.25, "sadece yarısını aldı."], [32.25, 34.36, "Cevabını yoruma yaz."], [36.21, 37.96, "Geri saralım. O dilekçe,"], [37.96, 39.13, "işe girdiği gün,"], [39.13, 42.12, "giriş evraklarının<br>arasında imzalatılmış."], [42.12, 45.48, "İlk mahkeme imzaya bakıp<br>tazminatı reddediyor."], [45.48, 47.45, "Ama dosya istinafa<br>gidiyor."], [47.95, 49.74, "İstinaf mahkemesi dedi<br>ki:"], [49.74, 52.92, "İş arayan birine giriş<br>günü istifa imzalatmak,"], [52.92, 55.34, "onun zor durumundan<br>yararlanmaktır."], [55.34, 57.28, "Bu dilekçeye itibar<br>edilmez."], [57.28, 60.04, "Şoför kıdem ve ihbar<br>tazminatını alacak."], [60.04, 62.5, "İzin defteri<br>sunulamadığı için izin"], [62.5, 63.84, "ücretini de alacak."], [63.84, 64.88, "Yargıtay onadı."], [65.48, 68.32, "Mahkemeye göre, işe<br>girerken imzalatılan"], [68.32, 71.38, "istifa dilekçesi seni<br>tazminatsız bırakmaz."], [71.38, 73.0, "Sen hangi şıkkı seçtin?"]], "_starts": [0.3, 7.449796, 13.606031999999999, 22.728073, 36.211678, 47.948503, 65.47564600000001]}