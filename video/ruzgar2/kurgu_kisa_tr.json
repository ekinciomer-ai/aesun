{"sahneler": [{"ad": "hero", "bas": 0, "son": 6.96025}, {"ad": "ruzgar", "bas": 6.96025, "son": 14.6035}, {"ad": "kanat", "bas": 14.6035, "son": 23.093563}, {"ad": "nasel", "bas": 23.093563, "son": 33.263626}, {"ad": "nakliye", "bas": 33.263626, "son": 39.913689000000005}, {"ad": "kurulum", "bas": 39.913689000000005, "son": 47.92375200000001}, {"ad": "uretim", "bas": 47.92375200000001, "son": 58.493815000000005}, {"ad": "koruma", "bas": 58.493815000000005, "son": 66.423878}, {"ad": "son", "bas": 66.423878, "son": 75.250191}], "altyazi": [{"bas": 0.4, "son": 2.781, "metin": "Yüz metreyi aşan kanatlar, rüzgârı nasıl"}, {"bas": 2.781, "son": 3.972, "metin": "elektriğe çeviriyor?"}, {"bas": 3.972, "son": 6.294, "metin": "Enerji Üretim Kaynakları, ikinci bölüm:"}, {"bas": 6.294, "son": 6.71, "metin": "rüzgâr!"}, {"bas": 6.96, "son": 8.852, "metin": "Rüzgâr aslında güneş enerjisidir."}, {"bas": 8.852, "son": 10.456, "metin": "Güneş Dünya'yı eşit ısıtmaz."}, {"bas": 10.456, "son": 12.691, "metin": "Isınan hava yükselir, yerine serin hava"}, {"bas": 12.691, "son": 14.354, "metin": "akar. İşte rüzgâr bu akıştır."}, {"bas": 14.604, "son": 16.325, "metin": "Kanatlar cam ve karbon elyaf"}, {"bas": 16.325, "son": 18.785, "metin": "katmanlarından, dev kalıplarda reçineyle"}, {"bas": 18.785, "son": 20.445, "metin": "tek parça hâlinde üretilir."}, {"bas": 20.445, "son": 22.844, "metin": "Bugün bazı kanatlar yüz metreyi aşıyor."}, {"bas": 23.094, "son": 25.498, "metin": "Kulenin tepesindeki gövdeye nasel denir."}, {"bas": 25.498, "son": 27.603, "metin": "İçinde ana mil, çoğu türbinde dişli"}, {"bas": 27.603, "son": 29.286, "metin": "kutusu ve jeneratör bulunur."}, {"bas": 29.286, "son": 31.511, "metin": "Bazı türbinlerde dişli kutusu yoktur;"}, {"bas": 31.511, "son": 33.014, "metin": "jeneratör doğrudan döner."}, {"bas": 33.264, "son": 35.075, "metin": "Dev kanatlar özel uzatılabilir"}, {"bas": 35.075, "son": 36.222, "metin": "dorselerle taşınır."}, {"bas": 36.222, "son": 38.637, "metin": "Bazen virajları dönebilmek için güzergâh"}, {"bas": 38.637, "son": 39.664, "metin": "baştan planlanır."}, {"bas": 39.914, "son": 41.767, "metin": "Sahada önce beton temel dökülür."}, {"bas": 41.767, "son": 43.91, "metin": "Kule parçaları dev vinçlerle üst üste"}, {"bas": 43.91, "son": 46.11, "metin": "dizilir; nasel ve kanatlar yüz metreyi"}, {"bas": 46.11, "son": 47.674, "metin": "aşan yüksekliğe kaldırılır."}, {"bas": 47.924, "son": 50.396, "metin": "Rüzgâr esince kanatlar, uçak kanadı gibi"}, {"bas": 50.396, "son": 52.806, "metin": "kaldırma kuvveti üretir ve rotor döner."}, {"bas": 52.806, "son": 55.154, "metin": "Jeneratör bu dönüşü elektriğe çevirir,"}, {"bas": 55.154, "son": 57.379, "metin": "trafo gerilimi yükseltir ve elektrik"}, {"bas": 57.379, "son": 58.244, "metin": "şebekeye akar."}, {"bas": 58.494, "son": 60.542, "metin": "Türbin, rüzgârın yönüne göre kendini"}, {"bas": 60.542, "son": 62.362, "metin": "çevirir. Fırtına çok sertleşince"}, {"bas": 62.362, "son": 64.581, "metin": "kanatlarının açısını değiştirir, rotoru"}, {"bas": 64.581, "son": 66.174, "metin": "yavaşlatır ve kendini korur."}, {"bas": 66.424, "son": 68.987, "metin": "Yakıt yok, duman yok; sadece hareket"}, {"bas": 68.987, "son": 71.834, "metin": "eden hava. Sıradaki bölümde: suyun gücü!"}, {"bas": 71.834, "son": 73.4, "metin": "Kozmos Lab'i takip et."}], "gecis": "flas", "toplam": 75.25, "dil": "tr", "olcek": 1.3333333333333333}